<div class="container section" style="text-align: center;">
  <h1>{{ section.settings.heading }}</h1>
  <p>{{ section.settings.text }}</p>
  {% if section.settings.button_label != blank %}
    <a href="{{ section.settings.button_link }}" class="btn">{{ section.settings.button_label }}</a>
  {% endif %}
</div>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Hive & Leaf"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Tea and raw honey for healthy daily rituals."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
