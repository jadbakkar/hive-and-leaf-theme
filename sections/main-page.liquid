<section class="section scheme-{{ section.settings.color_scheme | default: 'light' }}">
<div class="container" style="max-width:720px;">
  <h1>{{ page.title }}</h1>
  <div class="page-content">
    {{ page.content }}
  </div>
</div>
</section>

{% schema %}
{
  "name": "Page",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "cream",
          "label": "Cream"
        },
        {
          "value": "forest",
          "label": "Dark green"
        },
        {
          "value": "burgundy",
          "label": "Burgundy"
        }
      ],
      "default": "light"
    }
  ]
}
{% endschema %}
