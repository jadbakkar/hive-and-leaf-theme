<section class="section page-main {% render 'section-classes', settings: section.settings %}">
  <div class="container--narrow">
    <header class="page-header page-header--center page-header--rule page-main__header">
      <div class="page-header__titles">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow eyebrow--flank">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h1 class="page-header__title">{{ page.title }}</h1>
      </div>
    </header>
    <div class="page-main__content prose rte">
      {{ page.content }}
    </div>
  </div>
</section>

<style>
  .page-main { padding-top: clamp(40px, 5vw, 72px); }
  .page-main__header .eyebrow { justify-content: center; }
  .page-main__content { max-width: none; }
</style>

{% schema %}
{
  "name": "Page",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Short label"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "cream",
          "label": "Cream"
        },
        {
          "value": "forest",
          "label": "Dark green"
        },
        {
          "value": "burgundy",
          "label": "Burgundy"
        }
      ],
      "default": "light"
    }
  ]
}
{% endschema %}
