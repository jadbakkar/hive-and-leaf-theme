{%- if section.blocks.size > 0 -%}
<section class="announcement-bar scheme-{{ section.settings.color_scheme | default: 'forest' }}" data-announcement-bar data-interval="5000">
  <div class="container announcement-bar__inner">
    {%- for block in section.blocks -%}
      {%- liquid
        assign item_url = block.settings.url
        if item_url == blank and block.settings.link_whatsapp
          capture item_url
            render 'whatsapp-url', message: settings.whatsapp_message
          endcapture
        endif
      -%}
      <p class="announcement-bar__item" data-announcement-item {{ block.shopify_attributes }}{% unless forloop.first %} hidden{% endunless %}>
        {%- if block.settings.link_whatsapp and block.settings.url == blank and item_url != blank -%}
          <a href="{{ item_url }}" target="_blank" rel="noopener">{% render 'icon', name: 'whatsapp' %}{{ block.settings.text }}<span class="visually-hidden"> (opens WhatsApp)</span></a>
        {%- elsif item_url != blank -%}
          <a href="{{ item_url }}">{{ block.settings.text }}</a>
        {%- else -%}
          {{ block.settings.text }}
        {%- endif -%}
      </p>
    {%- endfor -%}
  </div>
</section>

<style>
  .announcement-bar {
    position: relative;
    font: 500 .68rem/1.4 var(--sans);
    letter-spacing: .18em;
    text-transform: uppercase;
  }
  .announcement-bar__inner {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 38px;
    padding-block: 8px;
    text-align: center;
  }
  .announcement-bar__item { margin: 0; }
  .announcement-bar__item[hidden] { display: none; }
  .announcement-bar__item a { text-decoration: none; border-bottom: 1px solid color-mix(in srgb, currentColor 40%, transparent); }
  .announcement-bar__item a:hover { border-bottom-color: currentColor; }
  .announcement-bar__item .icon { margin-right: 8px; font-size: 13px; vertical-align: -2px; }
</style>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "max_blocks": 3,
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "cream", "label": "Cream" },
        { "value": "forest", "label": "Dark (primary)" },
        { "value": "burgundy", "label": "Accent" }
      ],
      "default": "forest"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "url", "id": "url", "label": "Link (optional)" },
        { "type": "checkbox", "id": "link_whatsapp", "label": "Link to WhatsApp", "info": "Used when no link is set. Opens a chat with the number in Theme settings > Social media.", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        { "type": "announcement", "settings": { "text": "Cash on delivery across Lebanon" } },
        { "type": "announcement", "settings": { "text": "Order on WhatsApp", "link_whatsapp": true } }
      ]
    }
  ]
}
{% endschema %}
