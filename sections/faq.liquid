{%- assign link_href = section.settings.link | default: '/pages/contact' -%}
<section class="section faq faq--{{ section.settings.layout | default: 'split' }} {% render 'section-classes', settings: section.settings %}">
  <div class="container faq__grid">
    <div class="faq__intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow eyebrow--rule">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.index == 1 -%}
        <h1 class="faq__title h2">{{ section.settings.heading }}</h1>
      {%- else -%}
        <h2 class="faq__title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="faq__text lede">{{ section.settings.text }}</p>
      {%- endif -%}
      {%- if section.settings.link_label != blank -%}
        <a class="link-arrow faq__link" href="{{ link_href }}">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>

    <div class="faq__list accordion-group">
      {%- for block in section.blocks -%}
        <details class="accordion faq__item" {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
          <summary class="accordion__summary">
            <span class="faq__q">{{ block.settings.question }}</span>
            <span class="accordion__icon" aria-hidden="true"></span>
          </summary>
          <div class="accordion__body">
            <p>{{ block.settings.answer }}</p>
          </div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .faq__grid { display: grid; gap: 40px; }
  .faq__title { margin: 0; }
  .faq__text { margin: 20px 0 0; }
  .faq__link { margin-top: 28px; }
  .faq__q::first-letter { text-transform: uppercase; }
  .faq .accordion__summary { padding: 26px 0; font-size: clamp(1.125rem, 1.05rem + .3vw, 1.3rem); }
  .faq .accordion__body { padding-bottom: 30px; font-size: 1rem; line-height: 1.7; }
  .faq .accordion__body p { margin: 0; }
  .faq--stacked .faq__grid { max-width: 860px; margin-inline: auto; }
  @media (min-width: 990px) {
    .faq--split .faq__grid { grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: clamp(56px, 7vw, 120px); align-items: start; }
    .faq--split .faq__intro { position: sticky; top: 120px; }
  }
</style>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "info": "Small label above the heading",
      "default": "Short label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Page title"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Intro text",
      "default": "Supporting text goes here."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Contact us"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open the first question",
      "default": true
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "split", "label": "Heading beside questions" },
        { "value": "stacked", "label": "Heading above questions" }
      ],
      "default": "split"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "cream",
          "label": "Cream"
        },
        {
          "value": "forest",
          "label": "Dark (primary)"
        },
        {
          "value": "burgundy",
          "label": "Accent"
        }
      ],
      "default": "light"
    },
    {
      "type": "select",
      "id": "padding",
      "label": "Spacing",
      "options": [
        {
          "value": "s",
          "label": "Small"
        },
        {
          "value": "m",
          "label": "Medium"
        },
        {
          "value": "l",
          "label": "Large"
        }
      ],
      "default": "m"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Question goes here?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Answer goes here."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        }
      ]
    }
  ]
}
{% endschema %}
