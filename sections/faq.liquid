<style>
  .faq { max-width: 760px; }
  .faq details { border-bottom: 1px solid var(--line); padding: 16px 0; }
  .faq summary { cursor: pointer; font-family: var(--serif); font-size: 1.2rem; }
  .faq details p { color: var(--muted); margin: 12px 0 0; }
</style>

<section class="section">
  <div class="container faq">
    <h1>{{ section.settings.heading }}</h1>
    {% for block in section.blocks %}
      <details {{ block.shopify_attributes }}>
        <summary>{{ block.settings.question }}</summary>
        <p>{{ block.settings.answer }}</p>
      </details>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Page title" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Question goes here?" },
        { "type": "textarea", "id": "answer", "label": "Answer", "default": "Answer goes here." }
      ]
    }
  ],
  "presets": [
    { "name": "FAQ", "blocks": [ { "type": "item" }, { "type": "item" }, { "type": "item" } ] }
  ]
}
{% endschema %}
