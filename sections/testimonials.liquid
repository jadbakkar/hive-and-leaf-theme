{%- assign layout = section.settings.layout | default: 'statement' -%}
<section class="section testimonials testimonials--{{ layout }} {% render 'section-classes', settings: section.settings %}">
  <div class="container">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="testimonials__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="testimonials__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul class="testimonials__list" role="list" style="--rest: {{ section.blocks.size | minus: 1 | at_least: 1 }}; --count: {{ section.blocks.size | at_least: 1 }};">
      {%- for block in section.blocks -%}
        <li class="testimonials__item{% if layout == 'statement' and forloop.first %} testimonials__item--lead{% endif %}" {{ block.shopify_attributes }}>
          <figure class="testimonial">
            {%- if layout == 'statement' and forloop.first -%}
              <span class="testimonial__mark" aria-hidden="true">&ldquo;</span>
            {%- endif -%}
            <blockquote class="testimonial__quote">
              <p>{%- unless layout == 'statement' and forloop.first -%}&ldquo;{%- endunless -%}{{ block.settings.quote }}{%- unless layout == 'statement' and forloop.first -%}&rdquo;{%- endunless -%}</p>
            </blockquote>
            {%- if block.settings.author != blank -%}
              <figcaption class="testimonial__author">
                <span class="testimonial__name">{{ block.settings.author }}</span>
                {%- if block.settings.detail != blank -%}
                  <span class="testimonial__detail">{{ block.settings.detail }}</span>
                {%- endif -%}
              </figcaption>
            {%- endif -%}
          </figure>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

<style>
  .testimonials__header { margin-bottom: clamp(32px, 4vw, 48px); text-align: center; }
  .testimonials__heading { margin: 0; font-size: var(--fs-h3); }
  .testimonials__list { display: grid; gap: 0; margin: 0; padding: 0; list-style: none; }
  .testimonial { margin: 0; }
  .testimonial__quote { margin: 0; }
  .testimonial__quote p {
    margin: 0;
    font-family: var(--serif);
    font-size: 1.2rem;
    line-height: 1.45;
    color: var(--heading);
  }
  .testimonial__author {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    margin-top: 20px;
    font: 500 var(--fs-eyebrow)/1.3 var(--sans);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }
  .testimonial__author::before { content: ""; width: 20px; height: 1px; background: var(--eyebrow-rule); }
  .testimonial__detail { color: var(--fg-muted); }

  /* Grid layout and the supporting quotes of the statement layout */
  .testimonials__item { padding: 28px 0; border-top: 1px solid var(--rule); }
  .testimonials--grid .testimonials__list { gap: 0 clamp(24px, 3vw, 48px); }

  /* Statement layout: first quote large and centred */
  .testimonials__item--lead {
    grid-column: 1 / -1;
    padding: 0 0 clamp(48px, 6vw, 80px);
    border-top: 0;
    text-align: center;
  }
  .testimonials__item--lead .testimonial { max-width: 940px; margin-inline: auto; }
  .testimonial__mark {
    display: block;
    height: .5em;
    margin-bottom: 8px;
    color: var(--accent);
    font: 400 clamp(4rem, 8vw, 6.5rem)/1 var(--serif);
  }
  .testimonials__item--lead .testimonial__quote p {
    font-size: clamp(1.65rem, 1.1rem + 2.2vw, 3rem);
    line-height: 1.22;
    letter-spacing: -.015em;
    text-wrap: balance;
  }
  .testimonials__item--lead .testimonial__author { justify-content: center; margin-top: 32px; }
  .testimonials__item--lead .testimonial__author::before { display: none; }

  /* Supporting quotes in the statement layout: centred under the lead */
  .testimonials--statement .testimonials__item:not(.testimonials__item--lead) { text-align: center; }
  .testimonials--statement .testimonials__item:not(.testimonials__item--lead) .testimonial__author { justify-content: center; }
  .testimonials--statement .testimonials__item:not(.testimonials__item--lead) .testimonial__author::before { display: none; }

  @media (min-width: 768px) {
    .testimonials__list { column-gap: clamp(24px, 3vw, 48px); }
    .testimonials--grid .testimonials__list { grid-template-columns: repeat(min(var(--count), 3), minmax(0, 1fr)); }
    .testimonials--statement .testimonials__list { grid-template-columns: repeat(min(var(--rest), 3), minmax(0, 1fr)); max-width: 1040px; margin-inline: auto; }
    .testimonials__item { padding: 32px 0 0; }
    .testimonials__item--lead { padding: 0 0 clamp(56px, 6vw, 88px); }
  }
</style>

