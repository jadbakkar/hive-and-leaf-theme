<div class="container section">
  <h2 style="text-align: center;">{{ section.settings.heading }}</h2>
  <div class="grid">
    {% for block in section.blocks %}
      <blockquote class="testimonial" style="background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 24px; margin: 0;" {{ block.shopify_attributes }}>
        <p style="margin-top: 0;">&ldquo;{{ block.settings.quote }}&rdquo;</p>
        <footer style="color: var(--muted);">&mdash; {{ block.settings.author }}</footer>
      </blockquote>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Section heading"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Quote goes here."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Name"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "quote": "Quote goes here.",
            "author": "Name"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "Quote goes here.",
            "author": "Name"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "Quote goes here.",
            "author": "Name"
          }
        }
      ]
    }
  ]
}
{% endschema %}
