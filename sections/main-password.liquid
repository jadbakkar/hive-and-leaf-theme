<style>
  .password-page { max-width: 420px; margin-inline: auto; text-align: center; }
  .password-page__name { font-size: clamp(2.5rem, 6vw, 3.5rem); margin-bottom: var(--space-xs); }
  .password-page__status { font-family: var(--serif); font-style: italic; font-size: 1.4rem; color: var(--burgundy); margin: 0 0 var(--space-m); }
  .password-page__block { margin-top: var(--space-m); padding-top: var(--space-m); border-top: 1px solid var(--line); text-align: left; }
  .password-page__block h2 { font-size: 1.4rem; margin-bottom: var(--space-xs); }
  .password-page__block p { color: var(--muted); font-size: .95rem; margin: 0 0 var(--space-xs); }
  .password-form { display: flex; flex-direction: column; gap: 12px; }
  .password-form label { font-weight: 600; font-size: .9rem; }
  .password-form input[type="email"], .password-form input[type="password"] { width: 100%; padding: .8em 1.2em; border: 1px solid var(--line); border-radius: 999px; background: #fff; font: inherit; }
  .password-form .btn { border: 0; cursor: pointer; align-self: stretch; }
  .password-form__message { font-size: .9rem; margin: 0; }
  .password-form__message--error { color: var(--burgundy); }
  .password-details { margin-top: var(--space-m); border-top: 1px solid var(--line); padding-top: var(--space-s); }
  .password-details summary { cursor: pointer; font-family: var(--serif); font-size: 1.1rem; color: var(--forest); list-style-position: inside; }
  .password-details[open] summary { margin-bottom: var(--space-s); }
</style>

<section class="section password-section scheme-{{ section.settings.color_scheme | default: 'light' }}">
<div class="container">
  <div class="password-page">
    <h1 class="password-page__name">{{ shop.name }}</h1>
    <p class="password-page__status">Opening soon</p>

    <div class="password-page__block">
      <h2>Be the first to know</h2>
      <p>Sign up to hear when we open, and get news on new harvests.</p>

      {% form 'customer' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {% if form.posted_successfully? %}
          <p class="password-form__message" role="status">Thank you. You are on the list.</p>
        {% else %}
          {% if form.errors %}
            <p class="password-form__message password-form__message--error" role="alert">
              {{ form.errors.messages.email | default: 'Please enter a valid email address.' }}
            </p>
          {% endif %}
          <div class="password-form">
            <label for="newsletter-email-{{ section.id }}">Email address</label>
            <input type="email" id="newsletter-email-{{ section.id }}" name="contact[email]" value="{{ form.email | escape }}" autocomplete="email" required placeholder="you@example.com">
            <button type="submit" class="btn">Sign up</button>
          </div>
        {% endif %}
      {% endform %}
    </div>

    <details class="password-details">
      <summary>Enter with password</summary>
      {% form 'storefront_password' %}
        <div class="password-form">
          <label for="password-{{ section.id }}">Store password</label>
          <input type="password" id="password-{{ section.id }}" name="password" autocomplete="current-password" required>
          <button type="submit" class="btn">Enter</button>
        </div>
      {% endform %}
    </details>
  </div>
</div>
</section>

{% schema %}
{
  "name": "Password",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "cream",
          "label": "Cream"
        },
        {
          "value": "forest",
          "label": "Dark green"
        },
        {
          "value": "burgundy",
          "label": "Burgundy"
        }
      ],
      "default": "light"
    }
  ]
}
{% endschema %}
