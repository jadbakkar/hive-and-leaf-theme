<section class="section scheme-{{ section.settings.color_scheme | default: 'light' }}">
<div class="container" style="max-width:420px;">
  <h1>{{ shop.name }}</h1>

  {% form 'storefront_password' %}
    <p>
      <label for="password-{{ section.id }}">Store password</label><br>
      <input type="password" name="password" id="password-{{ section.id }}" required>
    </p>
    <p>
      <button type="submit" class="btn">Enter</button>
    </p>
  {% endform %}
</div>
</section>

{% schema %}
{
  "name": "Password",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "cream",
          "label": "Cream"
        },
        {
          "value": "forest",
          "label": "Dark green"
        },
        {
          "value": "burgundy",
          "label": "Burgundy"
        }
      ],
      "default": "light"
    }
  ]
}
{% endschema %}
