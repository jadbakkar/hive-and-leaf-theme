<section class="section password {% render 'section-classes', settings: section.settings %}">
  <div class="container">
    <div class="password__inner">
      <span class="icon-badge password__badge">{% render 'icon', name: 'honeycomb' %}</span>
      <p class="eyebrow eyebrow--flank">{{ section.settings.eyebrow }}</p>
      <h1 class="password__name display">{{ shop.name }}</h1>
      {%- if section.settings.text != blank -%}
        <p class="lede password__text">{{ section.settings.text }}</p>
      {%- endif -%}

      <div class="password__signup">
        <h2 class="password__label">{{ section.settings.signup_heading }}</h2>
        {%- form 'customer', class: 'password__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <p class="form-message password__message" role="status">Thank you. You are on the list.</p>
          {%- else -%}
            <div class="inline-form">
              <label class="visually-hidden" for="PasswordEmail-{{ section.id }}">Email address</label>
              <input class="input" type="email" id="PasswordEmail-{{ section.id }}" name="contact[email]" value="{{ form.email | escape }}" autocomplete="email" required placeholder="Email address">
              <button type="submit" class="btn">Notify me</button>
            </div>
            {%- if form.errors -%}
              <p class="form-message password__message password__message--error" role="alert">
                {{ form.errors.messages.email | default: 'Please enter a valid email address.' }}
              </p>
            {%- endif -%}
          {%- endif -%}
        {%- endform -%}
      </div>

      <details class="accordion accordion--small password__enter">
        <summary class="accordion__summary">Enter with password<span class="accordion__icon" aria-hidden="true"></span></summary>
        <div class="accordion__body">
          {%- form 'storefront_password', class: 'password__form' -%}
            <div class="inline-form">
              <label class="visually-hidden" for="Password-{{ section.id }}">Store password</label>
              <input class="input" type="password" id="Password-{{ section.id }}" name="password" autocomplete="current-password" required placeholder="Store password">
              <button type="submit" class="btn btn--outline">Enter</button>
            </div>
            {%- if form.errors -%}
              <p class="form-message password__message password__message--error" role="alert">That password is not right. Please try again.</p>
            {%- endif -%}
          {%- endform -%}
        </div>
      </details>
    </div>
  </div>
</section>

<style>
  .password__inner { display: flex; flex-direction: column; align-items: center; max-width: 620px; margin-inline: auto; text-align: center; }
  .password__badge { margin-bottom: 28px; }
  .password__inner .eyebrow { justify-content: center; }
  .password__name { margin: 0; }
  .password__text { margin: 24px auto 0; }
  .password__signup { width: 100%; margin-top: 48px; padding-top: 40px; border-top: 1px solid var(--rule); }
  .password__label { margin: 0 0 20px; font-size: var(--fs-h4); }
  .password__form { margin: 0; }
  .password__form .inline-form { margin-inline: auto; }
  .password__message { margin-top: 12px; }
  .password__message--error { color: var(--accent); }
  .password__enter { width: 100%; max-width: 480px; margin-top: 40px; border-top: 1px solid var(--rule); }
  .password__enter .accordion__summary { justify-content: center; gap: 16px; }
  .password__enter .accordion__body { max-width: none; }
</style>

{% schema %}
{
  "name": "Password",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Opening soon"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Supporting text goes here."
    },
    {
      "type": "text",
      "id": "signup_heading",
      "label": "Sign-up heading",
      "default": "Be the first to know"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "cream",
          "label": "Cream"
        },
        {
          "value": "forest",
          "label": "Dark green"
        },
        {
          "value": "burgundy",
          "label": "Burgundy"
        }
      ],
      "default": "light"
    }
  ]
}
{% endschema %}
