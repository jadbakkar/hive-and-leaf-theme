<style>
  .cart-page__title { margin-bottom: var(--space-m); }
  .cart-layout { display: grid; gap: var(--space-m); align-items: start; }
  @media (min-width: 900px) {
    .cart-layout { grid-template-columns: minmax(0, 1fr) 340px; }
  }

  .cart-head { display: none; }
  .cart-items { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .cart-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-xs) var(--space-s);
    align-items: center;
    padding: var(--space-s) 0;
    border-bottom: 1px solid var(--line);
  }
  .cart-row__product { grid-column: 1 / -1; display: flex; gap: var(--space-s); align-items: center; }
  .cart-row__media { width: 88px; flex-shrink: 0; }
  .cart-row__media .card-media { aspect-ratio: 4 / 5; border-radius: 10px; }
  .cart-row__title { font-family: var(--serif); font-size: 1.15rem; color: var(--forest); text-decoration: none; }
  .cart-row__variant { color: var(--muted); font-size: .9rem; }
  .cart-row__remove { display: inline-block; margin-top: 6px; font-size: .85rem; color: var(--muted); }
  .cart-row__qty input { width: 88px; padding: .5em .6em; border: 1px solid var(--line); border-radius: 999px; background: #fff; font: inherit; text-align: center; }
  .cart-row__price { display: none; }
  .cart-row__total { font-weight: 600; text-align: right; }

  .cart-note { margin-top: var(--space-m); }
  .cart-note label, .cart-note__label { display: block; font-weight: 600; margin-bottom: 8px; }
  .cart-note textarea { width: 100%; min-height: 96px; padding: .75em 1em; border: 1px solid var(--line); border-radius: 12px; background: #fff; font: inherit; resize: vertical; }

  .cart-summary { background: var(--cream); border-radius: 12px; padding: var(--space-m) var(--space-s); }
  .cart-summary__title { font-size: 1.5rem; margin-bottom: var(--space-s); }
  .cart-summary__row { display: flex; justify-content: space-between; gap: var(--space-s); font-weight: 600; font-size: 1.05rem; }
  .cart-summary__hint { margin: var(--space-xs) 0 var(--space-s); color: var(--muted); font-size: .9rem; }
  .cart-summary__cod { display: inline-block; margin-bottom: var(--space-s); padding: 6px 12px; border-radius: 999px; background: var(--paper); border: 1px solid var(--line); font-size: .8rem; letter-spacing: .02em; }
  .cart-summary__actions { display: grid; gap: var(--space-xs); }
  .cart-summary__actions .btn { text-align: center; border: 0; }
  .cart-summary__actions .btn--outline { border: 1px solid currentColor; }

  .cart-empty { text-align: center; padding: var(--space-l) 0; }
  .cart-empty h2 { margin-bottom: var(--space-s); }

  @media (min-width: 900px) {
    .cart-head {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 110px 110px 110px;
      gap: var(--space-s);
      padding: var(--space-xs) 0;
      font-size: .8rem;
      letter-spacing: .12em;
      text-transform: uppercase;
      color: var(--muted);
    }
    .cart-head span:not(:first-child) { text-align: center; }
    .cart-head span:last-child { text-align: right; }
    .cart-row { grid-template-columns: minmax(0, 1fr) 110px 110px 110px; }
    .cart-row__product { grid-column: auto; }
    .cart-row__qty { text-align: center; }
    .cart-row__price { display: block; text-align: center; }
    .cart-row__total { text-align: right; }
  }
</style>

<section class="section cart-section scheme-{{ section.settings.color_scheme | default: 'light' }}">
<div class="container">
  <h1 class="cart-page__title">Cart</h1>

  {% if cart.item_count > 0 %}
    {% form 'cart', cart %}
      <div class="cart-layout">
        <div>
          <div class="cart-head" aria-hidden="true">
            <span>Product</span>
            <span>Quantity</span>
            <span>Price</span>
            <span>Total</span>
          </div>

          <ul class="cart-items">
            {% for item in cart.items %}
              <li class="cart-row">
                <div class="cart-row__product">
                  <div class="cart-row__media">
                    <div class="card-media">
                      {% if item.image %}
                        {{ item.image | image_url: width: 240 | image_tag: alt: item.product.title, loading: 'lazy' }}
                      {% else %}
                        <div class="img-blank img-blank--portrait"></div>
                      {% endif %}
                    </div>
                  </div>
                  <div>
                    <a class="cart-row__title" href="{{ item.url }}">{{ item.product.title }}</a>
                    {% unless item.variant.title == 'Default Title' %}
                      <div class="cart-row__variant">{{ item.variant.title }}</div>
                    {% endunless %}
                    <div><a class="cart-row__remove" href="{{ item.url_to_remove }}">Remove<span class="visually-hidden"> {{ item.product.title }}</span></a></div>
                  </div>
                </div>

                <div class="cart-row__qty">
                  <label class="visually-hidden" for="updates-{{ forloop.index }}-{{ section.id }}">Quantity for {{ item.product.title }}</label>
                  <input type="number" id="updates-{{ forloop.index }}-{{ section.id }}" name="updates[]" value="{{ item.quantity }}" min="0">
                </div>

                <div class="cart-row__price">{{ item.final_price | money }}</div>
                <div class="cart-row__total">{{ item.final_line_price | money }}</div>
              </li>
            {% endfor %}
          </ul>

          {% if section.settings.show_note %}
            <div class="cart-note">
              <label for="cart-note-{{ section.id }}">Order note</label>
              <textarea id="cart-note-{{ section.id }}" name="note" rows="3" placeholder="Anything we should know about your order?">{{ cart.note | escape }}</textarea>
            </div>
          {% endif %}
        </div>

        <aside class="cart-summary" aria-labelledby="cart-summary-title-{{ section.id }}">
          <h2 id="cart-summary-title-{{ section.id }}" class="cart-summary__title">Order summary</h2>
          <div class="cart-summary__row">
            <span>Subtotal</span>
            <span>{{ cart.total_price | money }}</span>
          </div>
          <p class="cart-summary__hint">Taxes and delivery calculated at checkout.</p>

          {% if section.settings.cod_note != blank %}
            <p class="cart-summary__cod">{{ section.settings.cod_note }}</p>
          {% endif %}

          <div class="cart-summary__actions">
            <button type="submit" name="checkout" class="btn">Checkout</button>
            <button type="submit" name="update" class="btn btn--outline">Update cart</button>
          </div>
        </aside>
      </div>
    {% endform %}
  {% else %}
    <div class="cart-empty">
      <h2>Your cart is empty</h2>
      <a class="btn" href="{{ routes.all_products_collection_url }}">Continue shopping</a>
    </div>
  {% endif %}
</div>
</section>

{% schema %}
{
  "name": "Cart",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_note",
      "label": "Show order note",
      "default": true
    },
    {
      "type": "text",
      "id": "cod_note",
      "label": "Info note",
      "default": "Cash on delivery available"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "cream",
          "label": "Cream"
        },
        {
          "value": "forest",
          "label": "Dark green"
        },
        {
          "value": "burgundy",
          "label": "Burgundy"
        }
      ],
      "default": "light"
    }
  ]
}
{% endschema %}
