<style>
  .about-hero { text-align: center; }
  .about-hero__title { font-size: clamp(2.5rem, 6vw, 4.5rem); color: var(--forest); }
  .about-hero__sub { max-width: 640px; margin: 0 auto 40px; color: var(--muted); font-size: 1.15rem; }
  .about-frame { position: relative; width: 100%; border-radius: 12px; overflow: hidden; background: var(--cream); }
  .about-frame--wide { aspect-ratio: 16 / 9; }
</style>

<section class="section about-hero">
  <div class="container">
    <h1 class="about-hero__title">{{ section.settings.heading }}</h1>
    {% if section.settings.subheading != blank %}
      <p class="about-hero__sub">{{ section.settings.subheading }}</p>
    {% endif %}

    {% if section.settings.image != blank %}
      <div class="about-frame about-frame--wide">
        {{ section.settings.image | image_url: width: 1200 | image_tag: class: 'img-fill', loading: 'lazy' }}
      </div>
    {% else %}
      <div class="img-blank img-blank--wide"></div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "About hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Page title" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Supporting text goes here." },
    { "type": "image_picker", "id": "image", "label": "Image" }
  ],
  "presets": [
    { "name": "About hero" }
  ]
}
{% endschema %}
