<style>
  .about-founder__grid { display: grid; gap: 48px; align-items: center; grid-template-columns: 1fr; }
  .about-founder__text h2 { font-size: clamp(2rem, 4vw, 2.75rem); color: var(--burgundy); }
  .about-founder__sig { font-family: var(--serif); font-style: italic; font-size: 1.4rem; color: var(--honey); margin: 16px 0 0; }
  .about-frame { position: relative; width: 100%; border-radius: 12px; overflow: hidden; background: var(--cream); }
  .about-frame--portrait { aspect-ratio: 4 / 5; }
  @media (min-width: 768px) {
    .about-founder__grid { grid-template-columns: 1fr 1fr; }
  }
</style>

<section class="section about-founder">
  <div class="container about-founder__grid">
    <div class="about-founder__media">
      {% if section.settings.image != blank %}
        <div class="about-frame about-frame--portrait">
          {{ section.settings.image | image_url: width: 1200 | image_tag: class: 'img-fill', loading: 'lazy' }}
        </div>
      {% else %}
        <div class="img-blank img-blank--portrait"></div>
      {% endif %}
    </div>

    <div class="about-founder__text">
      <h2>{{ section.settings.heading }}</h2>
      <div class="rte">{{ section.settings.bio }}</div>
      {% if section.settings.signature != blank %}
        <p class="about-founder__sig">{{ section.settings.signature }}</p>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About founder",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Person heading" },
    { "type": "richtext", "id": "bio", "label": "Bio", "default": "<p>Short bio goes here.</p>" },
    { "type": "text", "id": "signature", "label": "Signature name", "default": "Name" },
    { "type": "image_picker", "id": "image", "label": "Portrait image" }
  ],
  "presets": [
    { "name": "About founder" }
  ]
}
{% endschema %}
