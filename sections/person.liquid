<section class="section person person--{{ section.settings.image_position | default: 'left' }} {% render 'section-classes', settings: section.settings %}">
  <div class="container person__grid">
    <div class="person__media media-frame">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 45vw, 100vw', widths: '600, 900, 1200, 1400', alt: section.settings.image.alt }}
      {%- else -%}
        <div class="img-blank" data-label="Portrait"></div>
      {%- endif -%}
    </div>

    <div class="person__text">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow eyebrow--rule">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="person__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.bio != blank -%}
        <div class="person__bio rte">{{ section.settings.bio }}</div>
      {%- endif -%}
      {%- if section.settings.signature != blank or section.settings.role != blank -%}
        <div class="person__sign">
          {%- if section.settings.signature != blank -%}
            <p class="person__sig">{{ section.settings.signature }}</p>
          {%- endif -%}
          {%- if section.settings.role != blank -%}
            <p class="person__role">{{ section.settings.role }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .person__grid { display: grid; gap: 40px; align-items: center; }
  .person__title { margin: 0 0 24px; }
  .person__bio { color: var(--fg-muted); font-size: var(--fs-lead); line-height: 1.65; }
  .person__sign { margin-top: 36px; padding-top: 28px; border-top: 1px solid var(--rule); max-width: var(--measure); }
  .person__sig { margin: 0; color: var(--accent); font: italic var(--heading-weight, 400) 1.75rem/1.2 var(--serif); }
  .person__role {
    margin: 10px 0 0;
    color: var(--fg-muted);
    font: 500 var(--fs-eyebrow)/1.3 var(--sans);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }
  @media (max-width: 767px) {
    .person__media { aspect-ratio: 4 / 4.4; }
  }
  @media (min-width: 768px) {
    .person__grid { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(48px, 7vw, 120px); }
    .person--right .person__grid { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); }
    .person--right .person__media { order: 2; }
  }
</style>

{% schema %}
{
  "name": "Person",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "info": "Small label above the heading", "default": "Short label" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Person heading" },
    { "type": "richtext", "id": "bio", "label": "Bio", "default": "<p>Short bio goes here.</p>" },
    { "type": "text", "id": "signature", "label": "Signature name", "default": "Name" },
    { "type": "text", "id": "role", "label": "Role", "default": "Role" },
    { "type": "image_picker", "id": "image", "label": "Portrait image" },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "cream", "label": "Cream" },
        { "value": "forest", "label": "Dark (primary)" },
        { "value": "burgundy", "label": "Accent" }
      ],
      "default": "light"
    },
    {
      "type": "select",
      "id": "padding",
      "label": "Spacing",
      "options": [
        { "value": "s", "label": "Small" },
        { "value": "m", "label": "Medium" },
        { "value": "l", "label": "Large" }
      ],
      "default": "m"
    }
  ],
  "presets": [
    { "name": "Person" }
  ]
}
{% endschema %}
