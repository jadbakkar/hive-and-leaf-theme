<style>
  .about-cta { text-align: center; }
  .about-cta__title { font-size: clamp(2.25rem, 5vw, 3.5rem); color: var(--forest); }
  .about-cta__text { max-width: 560px; margin: 0 auto 32px; color: var(--muted); font-size: 1.1rem; }
</style>

{% assign button_href = section.settings.button_link | default: routes.all_products_collection_url %}

<section class="section about-cta">
  <div class="container">
    <h2 class="about-cta__title">{{ section.settings.heading }}</h2>
    {% if section.settings.text != blank %}
      <p class="about-cta__text">{{ section.settings.text }}</p>
    {% endif %}
    <a class="btn" href="{{ button_href }}">{{ section.settings.button_label }}</a>
  </div>
</section>

{% schema %}
{
  "name": "About CTA",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Closing heading" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Supporting text goes here." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Button" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [
    { "name": "About CTA" }
  ]
}
{% endschema %}
