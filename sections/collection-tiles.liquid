{%- comment -%}
  Collection tiles: one editorial tile per product line (Skin, Hair, Honey, Herbs, Gift Sets...).
  Each tile is a tall arched (or rectangular) frame with the line's label colour as a thin band,
  echoing the coloured bands on the packaging labels. Without an image the frame shows a designed
  ivory "label" on warm stone. A swipeable scroll-snap row on phones.
{%- endcomment -%}
{%- liquid
  assign shape = section.settings.shape | default: 'arch'
  assign tile_count = section.blocks.size
  if tile_count > 5
    assign desktop_cols = 5
  elsif tile_count < 2
    assign desktop_cols = 2
  else
    assign desktop_cols = tile_count
  endif
-%}
<section class="section ctiles ctiles--{{ shape }} {% render 'section-classes', settings: section.settings %}" style="--ctiles-cols: {{ desktop_cols }};">
  <div class="container">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank -%}
      <div class="section-header{% if section.settings.header_alignment == 'center' %} section-header--center{% endif %}">
        <div class="section-header__titles">
          {%- if section.settings.eyebrow != blank -%}
            <p class="eyebrow {% if section.settings.header_alignment == 'center' %}eyebrow--flank{% else %}eyebrow--rule{% endif %}">{{ section.settings.eyebrow }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="section-header__title">{{ section.settings.heading }}</h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <p class="lede">{{ section.settings.text }}</p>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="ctiles__list" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign c = block.settings.collection
            assign tile_title = block.settings.title
            if tile_title == blank and c != blank
              assign tile_title = c.title
            endif
            if tile_title == blank
              assign tile_title = 'Collection'
            endif
            if c != blank
              assign tile_url = c.url
            else
              assign tile_url = routes.collections_url
            endif
            assign tile_image = block.settings.image
            if tile_image == blank and c != blank and section.settings.use_collection_image
              assign tile_image = c.featured_image
            endif
            assign tile_color = block.settings.accent_color | default: '#b08a4a'
          -%}
          <li class="ctile" style="--tile: {{ tile_color }};" {{ block.shopify_attributes }}>
            <a class="ctile__link" href="{{ tile_url }}">
              <div class="ctile__frame">
                {%- if tile_image != blank -%}
                  {{ tile_image | image_url: width: 900 | image_tag: class: 'ctile__img', loading: 'lazy', sizes: '(min-width: 990px) 20vw, (min-width: 768px) 30vw, 64vw', widths: '360, 540, 720, 900', alt: '' }}
                {%- else -%}
                  <div class="ctile__ph" aria-hidden="true">
                    <span class="ctile__label">
                      <span class="ctile__label-band"></span>
                      <span class="ctile__label-emblem">{% render 'icon', name: 'emblem' %}</span>
                      <span class="ctile__label-brand">{{ shop.name }}</span>
                      <span class="ctile__label-name">{{ tile_title }}</span>
                    </span>
                  </div>
                {%- endif -%}
                <span class="ctile__band" aria-hidden="true"></span>
              </div>
              <div class="ctile__body">
                <span class="ctile__index" aria-hidden="true">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
                <h3 class="ctile__title">{{ tile_title }}</h3>
                {%- if block.settings.text != blank -%}
                  <p class="ctile__text">{{ block.settings.text }}</p>
                {%- endif -%}
                {%- if section.settings.link_label != blank -%}
                  <span class="link-arrow ctile__more">{{ section.settings.link_label }}<span class="visually-hidden"> {{ tile_title }}</span></span>
                {%- endif -%}
              </div>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

<style>
  .ctiles__list {
    position: relative; /* contains the visually-hidden link text inside the scroll row */
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ctile { min-width: 0; }
  .ctile__link { display: flex; flex-direction: column; height: 100%; color: inherit; text-decoration: none; }
  .ctile .ctile__link:hover { color: inherit; }
  .ctile__link:focus-visible { outline-offset: 6px; }

  /* Frame: arch (default) or rectangle. A thin band in the line's colour sits at its foot. */
  .ctile__frame {
    position: relative;
    aspect-ratio: 3 / 4.3;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--ph-bg);
    isolation: isolate;
  }
  .ctiles--arch .ctile__frame { border-radius: 999px 999px var(--radius) var(--radius); }
  .ctile__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .9s var(--ease); }
  .ctile__band {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    height: 4px;
    background: var(--tile);
  }

  /* Placeholder: warm stone lit from the top left, an inset gold hairline that follows the
     frame's shape, and an ivory label like the ones on the jars and tins. */
  .ctile__ph {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background:
      radial-gradient(ellipse 80% 55% at 30% 8%, var(--ph-light), transparent 70%),
      linear-gradient(125deg, transparent 40%, var(--ph-shade) 62%, transparent 85%),
      linear-gradient(180deg, transparent 55%, color-mix(in srgb, var(--tile) 12%, transparent)),
      var(--ph-bg);
  }
  .ctile__ph::before {
    content: "";
    position: absolute;
    inset: 10px;
    border: 1px solid color-mix(in srgb, var(--detail) 50%, transparent);
    border-radius: inherit;
  }
  .ctiles--arch .ctile__ph::before { border-radius: 999px 999px 2px 2px; }
  .ctile__label {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    width: 70%;
    margin-top: 18%;
    padding: 0 8px 16px;
    overflow: hidden;
    border-radius: 2px;
    background: var(--paper);
    color: var(--primary);
    box-shadow: 0 1px 0 color-mix(in srgb, var(--primary) 6%, transparent), 0 18px 30px -22px color-mix(in srgb, var(--primary) 55%, transparent);
    text-align: center;
    transition: transform .6s var(--ease);
  }
  .ctile__label-band { align-self: stretch; height: 9px; margin: 0 -8px 8px; background: var(--tile); }
  .ctile__label-emblem { color: var(--gold); font-size: 14px; line-height: 0; }
  .ctile__label-brand { font: var(--heading-weight, 400) 1.2rem/1 var(--serif); }
  .ctile__label-name {
    padding-top: 6px;
    border-top: 1px solid color-mix(in srgb, var(--gold) 55%, transparent);
    color: var(--ink);
    font: 500 .52rem/1.2 var(--sans);
    letter-spacing: .24em;
    text-transform: uppercase;
  }

  .ctile__body { display: flex; flex-direction: column; align-items: flex-start; gap: 6px; padding-top: 20px; }
  .ctile__index { color: var(--eyebrow); font: 500 .68rem/1 var(--sans); letter-spacing: .2em; }
  .ctile__title { margin: 4px 0 0; font-size: clamp(1.35rem, 1.2rem + .5vw, 1.7rem); line-height: 1.1; }
  .ctile__text { margin: 0; color: var(--fg-muted); font-size: .92rem; line-height: 1.55; }
  .ctile__more { margin-top: 10px; }

  @media (hover: hover) {
    .ctile__link:hover .ctile__img { transform: scale(1.04); }
    .ctile__link:hover .ctile__label { transform: translateY(-6px); }
    .ctile__link:hover .ctile__title { color: var(--accent); }
    .ctile__link:hover .link-arrow { color: var(--accent); }
    .ctile__link:hover .link-arrow::after { transform: translateX(4px); }
  }

  @media (max-width: 767px) {
    /* Swipeable row: the next tile peeks in so the gesture is obvious. */
    .ctiles__list {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 62%;
      gap: 14px;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
    }
    .ctiles__list::-webkit-scrollbar { display: none; }
    .ctile { scroll-snap-align: start; }
    .ctile__text { font-size: .88rem; }
  }
  @media (min-width: 768px) {
    .ctiles__list { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 56px 24px; }
  }
  @media (min-width: 1100px) {
    .ctiles__list { grid-template-columns: repeat(var(--ctiles-cols, 5), minmax(0, 1fr)); gap: 24px; }
  }
</style>

{% schema %}
{
  "name": "Collection tiles",
  "tag": "div",
  "class": "section-collection-tiles",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "info": "Small label above the heading", "default": "The collections" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Rituals for skin, hair and home" },
    { "type": "textarea", "id": "text", "label": "Intro text (optional)" },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "shape",
      "label": "Tile shape",
      "options": [
        { "value": "arch", "label": "Arch" },
        { "value": "rectangle", "label": "Rectangle" }
      ],
      "default": "arch"
    },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop" },
    {
      "type": "checkbox",
      "id": "use_collection_image",
      "label": "Use the collection's image when a tile has none",
      "default": true
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "cream", "label": "Cream" },
        { "value": "forest", "label": "Dark (primary)" },
        { "value": "burgundy", "label": "Accent" }
      ],
      "default": "light"
    },
    {
      "type": "select",
      "id": "padding",
      "label": "Spacing",
      "options": [
        { "value": "s", "label": "Small" },
        { "value": "m", "label": "Medium" },
        { "value": "l", "label": "Large" }
      ],
      "default": "m"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title", "info": "Defaults to the collection's title" },
        { "type": "textarea", "id": "text", "label": "Short text" },
        { "type": "color", "id": "accent_color", "label": "Label colour", "info": "The thin band, like the colour on the product's label", "default": "#b08a4a" },
        { "type": "image_picker", "id": "image", "label": "Image" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection tiles",
      "blocks": [
        { "type": "tile", "settings": { "title": "Skin", "text": "Face and body oils, creams and scrub.", "accent_color": "#b7898a" } },
        { "type": "tile", "settings": { "title": "Hair", "text": "Oils and care for every length.", "accent_color": "#3f4b63" } },
        { "type": "tile", "settings": { "title": "Honey", "text": "Honey blends in jars and sachets.", "accent_color": "#a65f3c" } },
        { "type": "tile", "settings": { "title": "Herbs", "text": "Herbal teas in tins and powders.", "accent_color": "#2f4a3a" } },
        { "type": "tile", "settings": { "title": "Gift Sets", "text": "Boxed rituals, ready to give.", "accent_color": "#6e2233" } }
      ]
    }
  ]
}
{% endschema %}
