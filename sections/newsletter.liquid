<section class="section newsletter {% render 'section-classes', settings: section.settings %}">
<div class="container">
  <div style="max-width: 560px; margin-inline: auto; text-align: center;">
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.text }}</p>

    {% form 'customer' %}
      <input type="hidden" name="contact[tags]" value="newsletter">

      {% if form.posted_successfully? %}
        <p>Thanks for subscribing</p>
      {% else %}
        <input type="email" name="contact[email]" placeholder="Your email" autocomplete="email" required style="padding: .8em 1em; border: 1px solid var(--line); border-radius: 999px; width: 100%; max-width: 360px; font: inherit;">
        <div style="margin-top: 12px;">
          <input type="submit" class="btn" value="{{ section.settings.button_label }}">
        </div>
        {% if form.errors %}
          <p>Please enter a valid email address.</p>
        {% endif %}
      {% endif %}
    {% endform %}
  </div>
</div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Newsletter heading"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Short newsletter description goes here."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "cream",
          "label": "Cream"
        },
        {
          "value": "forest",
          "label": "Dark green"
        },
        {
          "value": "burgundy",
          "label": "Burgundy"
        }
      ],
      "default": "light"
    },
    {
      "type": "select",
      "id": "padding",
      "label": "Spacing",
      "options": [
        {
          "value": "s",
          "label": "Small"
        },
        {
          "value": "m",
          "label": "Medium"
        },
        {
          "value": "l",
          "label": "Large"
        }
      ],
      "default": "m"
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
