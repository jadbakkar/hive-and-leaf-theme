{%- assign layout = section.settings.layout | default: 'split' -%}
<section class="section newsletter newsletter--{{ layout }} {% render 'section-classes', settings: section.settings %}">
  <div class="container">
    <div class="newsletter__inner{% if layout == 'center' %} text-center{% endif %}">
      <div class="newsletter__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow eyebrow--rule">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="newsletter__heading">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="newsletter__text">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>

      <div class="newsletter__form-wrap">
        {%- form 'customer', class: 'newsletter__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <p class="newsletter__message" role="status">Thanks for subscribing.</p>
          {%- else -%}
            <label class="visually-hidden" for="newsletter-email-{{ section.id }}">Email address</label>
            <div class="inline-form">
              <input class="input" type="email" name="contact[email]" id="newsletter-email-{{ section.id }}" placeholder="Email address" autocomplete="email" required{% if form.errors %} aria-invalid="true" aria-describedby="newsletter-error-{{ section.id }}"{% endif %}>
              <button type="submit" class="btn">{{ section.settings.button_label | default: 'Subscribe' }}</button>
            </div>
            {%- if form.errors -%}
              <p class="newsletter__message" id="newsletter-error-{{ section.id }}" role="alert">Please enter a valid email address.</p>
            {%- endif -%}
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

<style>
  .newsletter__inner { display: grid; gap: 32px; }
  .newsletter__heading { margin-bottom: 16px; }
  .newsletter__text { margin: 0; color: var(--fg-muted); max-width: 46ch; }
  .newsletter__form { margin: 0; }
  .newsletter__message { margin: 12px 0 0; font-size: var(--fs-small); }
  .newsletter--center .newsletter__inner { max-width: 640px; margin-inline: auto; justify-items: center; }
  .newsletter--center .newsletter__text { margin-inline: auto; }
  .newsletter--center .inline-form { margin-inline: auto; }
  @media (min-width: 768px) {
    .newsletter--split .newsletter__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: end;
      gap: clamp(40px, 6vw, 96px);
    }
    .newsletter--split .newsletter__heading { margin-bottom: 16px; }
    .newsletter--split .inline-form { max-width: none; }
  }
</style>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "info": "Small label above the heading",
      "default": "Short label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Newsletter heading"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Short newsletter description goes here."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "split",
          "label": "Text and form side by side"
        },
        {
          "value": "center",
          "label": "Centered"
        }
      ],
      "default": "split"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "cream",
          "label": "Cream"
        },
        {
          "value": "forest",
          "label": "Dark (primary)"
        },
        {
          "value": "burgundy",
          "label": "Accent"
        }
      ],
      "default": "light"
    },
    {
      "type": "select",
      "id": "padding",
      "label": "Spacing",
      "options": [
        {
          "value": "s",
          "label": "Small"
        },
        {
          "value": "m",
          "label": "Medium"
        },
        {
          "value": "l",
          "label": "Large"
        }
      ],
      "default": "m"
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
