<section class="section video {% render 'section-classes', settings: section.settings %}">
  <div class="container">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="section-header{% if section.settings.center %} section-header--center{% endif %}">
        <div class="section-header__titles">
          {%- if section.settings.eyebrow != blank -%}
            <p class="eyebrow {% if section.settings.center %}eyebrow--flank{% else %}eyebrow--rule{% endif %}">{{ section.settings.eyebrow }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="section-header__title">{{ section.settings.heading }}</h2>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <div class="video__frame media-frame media-frame--wide">
      {%- if section.settings.video != blank -%}
        {{ section.settings.video | external_video_url | external_video_tag: class: 'video__embed' }}
      {%- else -%}
        <div class="img-blank" data-label="Video"></div>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .video__frame iframe, .video__frame video { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
</style>

{% schema %}
{
  "name": "Video",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "info": "Small label above the heading", "default": "Short label" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Section heading" },
    { "type": "checkbox", "id": "center", "label": "Center the heading", "default": false },
    { "type": "video_url", "id": "video", "label": "Video", "accept": ["youtube", "vimeo"] },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "cream", "label": "Cream" },
        { "value": "forest", "label": "Dark green" },
        { "value": "burgundy", "label": "Burgundy" }
      ],
      "default": "light"
    },
    {
      "type": "select",
      "id": "padding",
      "label": "Spacing",
      "options": [
        { "value": "s", "label": "Small" },
        { "value": "m", "label": "Medium" },
        { "value": "l", "label": "Large" }
      ],
      "default": "m"
    }
  ],
  "presets": [
    { "name": "Video" }
  ]
}
{% endschema %}
