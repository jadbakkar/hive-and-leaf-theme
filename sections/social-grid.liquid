{%- comment -%}
  Social grid: an Instagram-style grid of square images (blocks: image + optional link), a handle as
  the heading and a button to the Instagram profile from Theme settings > Social media.
  Shopify themes cannot read the Instagram feed itself, so the merchant picks the images.
{%- endcomment -%}
{%- liquid
  assign profile_url = section.settings.button_link | default: settings.social_instagram
-%}
<section class="section social-grid {% render 'section-classes', settings: section.settings %}">
  <div class="container">
    <div class="social-grid__header">
      <div class="social-grid__titles">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow eyebrow--rule">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="social-grid__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="lede social-grid__text">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.button_label != blank and profile_url != blank -%}
        <a class="btn btn--outline social-grid__btn" href="{{ profile_url }}" target="_blank" rel="noopener">
          {%- render 'icon', name: 'instagram' -%}
          <span>{{ section.settings.button_label }}</span>
          <span class="visually-hidden">(opens in a new tab)</span>
        </a>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="social-grid__list" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign post_url = block.settings.link | default: profile_url
            assign post_alt = block.settings.alt | default: section.settings.heading
          -%}
          <li class="social-grid__item" {{ block.shopify_attributes }}>
            {%- if post_url != blank -%}
              <a class="social-grid__tile" href="{{ post_url }}">
            {%- else -%}
              <div class="social-grid__tile">
            {%- endif -%}
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 720 | image_tag: class: 'social-grid__img', loading: 'lazy', sizes: '(min-width: 990px) 16vw, 33vw', widths: '240, 360, 540, 720', alt: post_alt }}
                {%- else -%}
                  <div class="img-blank img-blank--square img-blank--small social-grid__ph" data-label="Post {{ forloop.index }}"></div>
                  {%- if post_url != blank -%}<span class="visually-hidden">{{ post_alt }}, post {{ forloop.index }}</span>{%- endif -%}
                {%- endif -%}
                <span class="social-grid__hover" aria-hidden="true">{% render 'icon', name: 'instagram' %}</span>
            {%- if post_url != blank -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

<style>
  .social-grid__header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px 40px;
    margin-bottom: clamp(28px, 4vw, 48px);
  }
  .social-grid__titles { max-width: 640px; }
  .social-grid__heading { margin: 0; font-size: var(--fs-h2); letter-spacing: -.01em; }
  .social-grid__text { margin: 14px 0 0; }
  .social-grid__btn .icon { font-size: 17px; }

  .social-grid__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 990px) {
    .social-grid__list { grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 12px; }
  }
  .social-grid__item { min-width: 0; }
  .social-grid__tile {
    position: relative;
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--ph-bg);
    color: inherit;
  }
  .social-grid__tile:focus-visible { outline-offset: 3px; }
  .social-grid__img { width: 100%; height: 100%; object-fit: cover; transition: transform .8s var(--ease); }
  .social-grid__ph { position: absolute; inset: 0; height: 100%; aspect-ratio: auto; border-radius: 0; }
  /* Placeholder rhythm: each tile leans towards one of the label colours of the range. */
  .social-grid__item:nth-child(6n+1) .social-grid__ph { --ph-bg: color-mix(in srgb, #b7898a 14%, var(--stone)); }
  .social-grid__item:nth-child(6n+2) .social-grid__ph { --ph-bg: var(--stone-strong); }
  .social-grid__item:nth-child(6n+3) .social-grid__ph { --ph-bg: color-mix(in srgb, #8b9a7b 16%, var(--stone)); }
  .social-grid__item:nth-child(6n+4) .social-grid__ph { --ph-bg: color-mix(in srgb, #a65f3c 12%, var(--stone)); }
  .social-grid__item:nth-child(6n+5) .social-grid__ph { --ph-bg: var(--stone); }
  .social-grid__item:nth-child(6n+6) .social-grid__ph { --ph-bg: color-mix(in srgb, #3f4b63 10%, var(--stone)); }
  .scheme-forest .social-grid__ph, .scheme-burgundy .social-grid__ph { --ph-bg: color-mix(in srgb, var(--paper) 8%, var(--bg)) !important; }
  .social-grid__hover {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--primary-deep) 42%, transparent);
    color: var(--paper);
    font-size: 26px;
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }
  @media (hover: hover) {
    a.social-grid__tile:hover .social-grid__hover,
    a.social-grid__tile:focus-visible .social-grid__hover { opacity: 1; }
    a.social-grid__tile:hover .social-grid__img { transform: scale(1.04); }
  }
  @media (max-width: 767px) {
    .social-grid__ph::after { display: none; }
    .social-grid__btn { width: 100%; }
  }
</style>

{% schema %}
{
  "name": "Instagram grid",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "info": "Small label above the heading", "default": "Follow our rituals" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "@mezaj.rituals" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Ask us anything by DM, or order straight from Instagram." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Follow on Instagram" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Defaults to the Instagram URL in Theme settings > Social media" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "cream", "label": "Cream" },
        { "value": "forest", "label": "Dark (primary)" },
        { "value": "burgundy", "label": "Accent" }
      ],
      "default": "light"
    },
    {
      "type": "select",
      "id": "padding",
      "label": "Spacing",
      "options": [
        { "value": "s", "label": "Small" },
        { "value": "m", "label": "Medium" },
        { "value": "l", "label": "Large" }
      ],
      "default": "m"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "alt", "label": "Image description", "info": "For screen readers" },
        { "type": "url", "id": "link", "label": "Link (optional)", "info": "Defaults to the Instagram profile" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram grid",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
