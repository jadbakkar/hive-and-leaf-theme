<section class="section icon-columns {% render 'section-classes', settings: section.settings %}">
  <div class="container">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="section-header section-header--rule">
        <div class="section-header__titles">
          {%- if section.settings.eyebrow != blank -%}
            <p class="eyebrow eyebrow--rule">{{ section.settings.eyebrow }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="section-header__title">{{ section.settings.heading }}</h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <p class="lede">{{ section.settings.text }}</p>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <ul class="icon-columns__grid" role="list" style="--cols: {{ section.settings.columns | default: 3 }};">
      {%- for block in section.blocks -%}
        <li class="icon-columns__item" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="icon-columns__media media-frame media-frame--square">
              {{ block.settings.image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 240', sizes: '72px', alt: block.settings.image.alt }}
            </div>
          {%- else -%}
            <span class="icon-badge">{% render 'icon', name: block.settings.builtin_icon %}</span>
          {%- endif -%}
          <h3 class="icon-columns__title h4">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}
            <p class="icon-columns__text">{{ block.settings.text }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

<style>
  .icon-columns__grid { display: grid; gap: 40px; margin: 0; padding: 0; list-style: none; }
  .icon-columns__item { display: flex; flex-direction: column; align-items: flex-start; min-width: 0; }
  .icon-columns__item .icon-badge, .icon-columns__media { margin-bottom: 24px; }
  .icon-columns__media { width: 72px; }
  .icon-columns__title { margin: 0 0 10px; font-size: 1.35rem; }
  .icon-columns__text { margin: 0; color: var(--fg-muted); max-width: 36ch; }
  @media (max-width: 599px) {
    /* Phones: icon beside the text, hairline between rows, so the list stays compact. */
    .icon-columns__grid { gap: 0; border-top: 1px solid var(--rule); }
    .icon-columns__item {
      display: grid;
      grid-template-columns: 52px minmax(0, 1fr);
      column-gap: 20px;
      align-items: start;
      padding: 24px 0;
      border-bottom: 1px solid var(--rule);
    }
    .icon-columns__item .icon-badge, .icon-columns__media { grid-row: span 2; width: 52px; height: 52px; margin: 0; font-size: 22px; }
    .icon-columns__title { margin: 4px 0 6px; font-size: 1.2rem; }
    .section-header + .icon-columns__grid { border-top: 0; }
    .section-header + .icon-columns__grid .icon-columns__item:first-child { padding-top: 0; }
  }
  @media (min-width: 600px) and (max-width: 989px) {
    .icon-columns__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 48px 32px; }
  }
  @media (min-width: 990px) {
    .icon-columns__grid { grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr)); gap: 0; }
    .icon-columns__item { padding: 8px clamp(24px, 3vw, 48px); }
    .icon-columns__item:first-child { padding-left: 0; }
    .icon-columns__item + .icon-columns__item { border-left: 1px solid var(--rule); }
  }
</style>

{% schema %}
{
  "name": "Icon columns",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "info": "Small label above the heading", "default": "Short label" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Section heading" },
    { "type": "textarea", "id": "text", "label": "Intro text (optional)" },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns per row",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "cream", "label": "Cream" },
        { "value": "forest", "label": "Dark (primary)" },
        { "value": "burgundy", "label": "Accent" }
      ],
      "default": "light"
    },
    {
      "type": "select",
      "id": "padding",
      "label": "Spacing",
      "options": [
        { "value": "s", "label": "Small" },
        { "value": "m", "label": "Medium" },
        { "value": "l", "label": "Large" }
      ],
      "default": "m"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "select",
          "id": "builtin_icon",
          "label": "Icon",
          "info": "Used when no image is chosen",
          "options": [
            { "value": "leaf", "label": "Leaf" },
            { "value": "drop", "label": "Drop" },
            { "value": "honeycomb", "label": "Honeycomb" },
            { "value": "jar", "label": "Jar" },
            { "value": "cup", "label": "Cup" },
            { "value": "sprout", "label": "Sprout" },
            { "value": "hand", "label": "Hand" },
            { "value": "truck", "label": "Truck" },
            { "value": "cash", "label": "Cash" }
          ],
          "default": "leaf"
        },
        { "type": "image_picker", "id": "image", "label": "Icon image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Column title" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Short description goes here." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Icon columns",
      "blocks": [
        { "type": "column", "settings": { "builtin_icon": "drop", "title": "Column title", "text": "Short description goes here." } },
        { "type": "column", "settings": { "builtin_icon": "leaf", "title": "Column title", "text": "Short description goes here." } },
        { "type": "column", "settings": { "builtin_icon": "hand", "title": "Column title", "text": "Short description goes here." } }
      ]
    }
  ]
}
{% endschema %}
