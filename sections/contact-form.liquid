<style>
  .contact-form { max-width: 640px; }
  .contact-form__field { display: grid; gap: 6px; margin-bottom: 16px; }
  .contact-form input, .contact-form textarea { font: inherit; padding: .7em 1em; border: 1px solid var(--line); border-radius: 8px; background: #fff; }
</style>

<section class="section contact-form-section {% render 'section-classes', settings: section.settings %}">
  <div class="container contact-form">
    <h1>{{ section.settings.heading }}</h1>
    {% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}
    {% form 'contact' %}
      {% if form.posted_successfully? %}<p>Thanks, we will be in touch.</p>{% endif %}
      <div class="contact-form__field"><label for="cf-name">Name</label><input id="cf-name" name="contact[name]" type="text"></div>
      <div class="contact-form__field"><label for="cf-email">Email</label><input id="cf-email" name="contact[email]" type="email" required></div>
      <div class="contact-form__field"><label for="cf-body">Message</label><textarea id="cf-body" name="contact[body]" rows="6"></textarea></div>
      <button class="btn" type="submit">Send</button>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Page title"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Supporting text goes here."
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "cream",
          "label": "Cream"
        },
        {
          "value": "forest",
          "label": "Dark green"
        },
        {
          "value": "burgundy",
          "label": "Burgundy"
        }
      ],
      "default": "light"
    },
    {
      "type": "select",
      "id": "padding",
      "label": "Spacing",
      "options": [
        {
          "value": "s",
          "label": "Small"
        },
        {
          "value": "m",
          "label": "Medium"
        },
        {
          "value": "l",
          "label": "Large"
        }
      ],
      "default": "m"
    }
  ],
  "presets": [
    {
      "name": "Contact form"
    }
  ]
}
{% endschema %}
