{%- liquid
  assign button_href = section.settings.button_link | default: routes.all_products_collection_url
  assign align = section.settings.alignment | default: 'center'
  case section.settings.button_style
    when 'primary'
      assign button_class = 'btn'
    when 'link'
      assign button_class = 'link-arrow'
    else
      assign button_class = 'btn btn--outline'
  endcase
-%}
<section class="section rich-text rich-text--{{ align }} {% render 'section-classes', settings: section.settings %}">
  <div class="container">
    <div class="rich-text__inner{% if align == 'center' %} text-center{% endif %}">
      {%- if section.settings.show_emblem -%}
        <span class="rich-text__emblem" aria-hidden="true">{% render 'icon', name: 'emblem' %}</span>
      {%- endif -%}
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="rich-text__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="rte rich-text__text">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <div class="btn-row rich-text__actions">
          <a href="{{ button_href }}" class="{{ button_class }}">{{ section.settings.button_label }}</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .rich-text__inner { max-width: 860px; }
  .rich-text--center .rich-text__inner { margin-inline: auto; }
  .rich-text__heading { margin-bottom: 24px; }
  .rich-text__emblem { display: block; margin-bottom: 26px; color: var(--detail); font-size: 34px; line-height: 0; }
  .rich-text__emblem .icon { stroke-width: 1; }
  .rich-text--center .rich-text__emblem { display: flex; justify-content: center; }
  .rich-text__text { font-size: var(--fs-lead); line-height: 1.65; color: var(--fg-muted); }
  .rich-text__actions { margin-top: 36px; }
  .rich-text--center .eyebrow { justify-content: center; }
</style>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "info": "Small label above the heading",
      "default": "Short label"
    },
    {
      "type": "checkbox",
      "id": "show_emblem",
      "label": "Show emblem above the text",
      "default": false
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Section heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Body text goes here.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Button"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Defaults to all products"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        {
          "value": "primary",
          "label": "Filled"
        },
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "link",
          "label": "Text link"
        }
      ],
      "default": "outline"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "cream",
          "label": "Cream"
        },
        {
          "value": "forest",
          "label": "Dark (primary)"
        },
        {
          "value": "burgundy",
          "label": "Accent"
        }
      ],
      "default": "light"
    },
    {
      "type": "select",
      "id": "padding",
      "label": "Spacing",
      "options": [
        {
          "value": "s",
          "label": "Small"
        },
        {
          "value": "m",
          "label": "Medium"
        },
        {
          "value": "l",
          "label": "Large"
        }
      ],
      "default": "m"
    }
  ],
  "presets": [
    {
      "name": "Rich text"
    }
  ]
}
{% endschema %}
