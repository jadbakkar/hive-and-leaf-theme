<div class="container section">
  <div class="iwt iwt--{{ section.settings.image_position }}">
    <div class="iwt__media">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1200 | image_tag: class: 'img-fill', loading: 'lazy' }}
      {% else %}
        <div class="img-blank img-blank--portrait"></div>
      {% endif %}
    </div>
    <div class="iwt__content">
      <h2>{{ section.settings.heading }}</h2>
      <div>{{ section.settings.text }}</div>
      {% if section.settings.button_label != blank %}
        <a href="{{ section.settings.button_link }}" class="btn">{{ section.settings.button_label }}</a>
      {% endif %}
    </div>
  </div>
</div>

<style>
  .iwt { display: grid; grid-template-columns: 1fr; gap: 24px; align-items: center; }
  .iwt__content p:first-child { margin-top: 0; }
  @media (min-width: 768px) {
    .iwt { grid-template-columns: 1fr 1fr; gap: 48px; }
    .iwt--right .iwt__media { order: 2; }
  }
</style>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Section heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Body text goes here.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Button"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Image with text"
    }
  ]
}
{% endschema %}
