{%- assign button_href = section.settings.button_link | default: routes.all_products_collection_url -%}
<section class="section image-with-text {% render 'section-classes', settings: section.settings %}">
  <div class="container">
    <div class="iwt iwt--{{ section.settings.image_position | default: 'left' }}">
      <div class="iwt__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1400 | image_tag: class: 'img-fill', loading: 'lazy', sizes: '(min-width: 768px) 55vw, 100vw', widths: '600, 900, 1200, 1400' }}
        {%- else -%}
          <div class="img-blank" data-label="Image"></div>
        {%- endif -%}
      </div>
      <div class="iwt__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow eyebrow--rule">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="iwt__heading">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <div class="rte iwt__text">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <div class="btn-row iwt__actions">
            <a href="{{ button_href }}" class="btn">{{ section.settings.button_label }}</a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
  .iwt { display: grid; grid-template-columns: 1fr; gap: 40px; align-items: center; }
  .iwt__media { position: relative; aspect-ratio: 4 / 3; border-radius: var(--radius); overflow: hidden; background: var(--ph-bg); }
  .iwt__media .img-fill, .iwt__media .img-blank { position: absolute; inset: 0; height: 100%; aspect-ratio: auto; border-radius: 0; }
  .iwt__heading { margin-bottom: 24px; }
  .iwt__text { color: var(--fg-muted); font-size: var(--fs-lead); line-height: 1.65; }
  .iwt__actions { margin-top: 36px; }
  @media (min-width: 768px) {
    .iwt { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(48px, 7vw, 112px); }
    .iwt__media { aspect-ratio: 5 / 6; }
    .iwt--right { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
    .iwt--right .iwt__media { order: 2; }
    .iwt__content { max-width: 480px; }
  }
</style>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "info": "Small label above the heading",
      "default": "Short label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Section heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Body text goes here.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Button"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Defaults to all products"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "cream",
          "label": "Cream"
        },
        {
          "value": "forest",
          "label": "Dark green"
        },
        {
          "value": "burgundy",
          "label": "Burgundy"
        }
      ],
      "default": "cream"
    },
    {
      "type": "select",
      "id": "padding",
      "label": "Spacing",
      "options": [
        {
          "value": "s",
          "label": "Small"
        },
        {
          "value": "m",
          "label": "Medium"
        },
        {
          "value": "l",
          "label": "Large"
        }
      ],
      "default": "m"
    }
  ],
  "presets": [
    {
      "name": "Image with text"
    }
  ]
}
{% endschema %}
