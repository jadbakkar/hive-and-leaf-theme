{%- liquid
  assign header_id = 'site-nav-' | append: section.id
  assign scheme = section.settings.color_scheme | default: 'light'
  assign menu = section.settings.menu
-%}
<header class="site-header scheme-{{ scheme }}" data-site-header{% if section.settings.sticky %} data-sticky="true"{% endif %}>
  <div class="container site-header__inner">
    <button type="button" class="site-header__icon-btn site-header__toggle" data-nav-open aria-expanded="false" aria-controls="{{ header_id }}">
      {%- render 'icon', name: 'menu' -%}
      <span class="visually-hidden">Open menu</span>
    </button>
    <a class="site-header__logo" href="{{ routes.root_url }}">
      {%- if settings.logo -%}
        {{ settings.logo | image_url: width: 600 | image_tag: width: settings.logo_width, loading: 'eager', alt: shop.name, class: 'site-header__logo-img' }}
      {%- else -%}
        <span class="site-header__wordmark">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    <nav class="site-header__nav" id="{{ header_id }}" aria-label="Main" data-nav>
      <div class="site-header__nav-top">
        <span class="site-header__nav-title">Menu</span>
        <button type="button" class="site-header__icon-btn" data-nav-close>
          {%- render 'icon', name: 'close' -%}
          <span class="visually-hidden">Close menu</span>
        </button>
      </div>
      <ul class="site-header__menu">
        {%- for link in menu.links -%}
          <li class="site-header__item">
            {%- if link.links.size > 0 -%}
              <details class="site-header__dropdown">
                <summary>{{ link.title }}</summary>
                <ul class="site-header__sub">
                  {%- for child in link.links -%}
                    <li><a href="{{ child.url }}"{% if child.active %} aria-current="page"{% endif %}>{{ child.title }}</a></li>
                  {%- endfor -%}
                </ul>
              </details>
            {%- else -%}
              <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
            {%- endif -%}
          </li>
        {%- endfor -%}
        {%- if shop.customer_accounts_enabled -%}
          <li class="site-header__item site-header__account-link">
            <a href="{{ routes.account_login_url }}">Account</a>
          </li>
        {%- endif -%}
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="site-header__icon-btn" href="{{ routes.search_url }}">
        {%- render 'icon', name: 'search' -%}
        <span class="visually-hidden">Search</span>
      </a>
      {%- if shop.customer_accounts_enabled -%}
        <a class="site-header__icon-btn site-header__account" href="{{ routes.account_login_url }}">
          {%- render 'icon', name: 'account' -%}
          <span class="visually-hidden">Account</span>
        </a>
      {%- endif -%}
      <a class="site-header__icon-btn site-header__cart" href="{{ routes.cart_url }}" data-cart-open>
        {%- render 'icon', name: 'cart' -%}
        <span class="visually-hidden">Cart</span>
        <span class="site-header__count" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
  <div class="site-header__overlay" data-nav-overlay hidden></div>
</header>

<style>
  .shopify-section:has(> .site-header[data-sticky="true"]) {
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .site-header {
    position: relative;
    z-index: 50;
    background: var(--bg);
    border-bottom: 1px solid var(--rule);
    transition: box-shadow var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .site-header.is-scrolled {
    box-shadow: 0 10px 30px -22px rgba(26, 58, 42, .45);
  }
  .site-header__inner {
    min-height: 64px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 8px;
  }
  .site-header__logo {
    grid-column: 2;
    justify-self: center;
    display: inline-flex;
    align-items: center;
    padding-block: 10px;
    text-decoration: none;
    color: var(--heading);
  }
  .site-header__logo:hover { color: var(--heading) !important; }
  .site-header__logo-img { height: auto; max-width: 100%; }
  .site-header__wordmark {
    font-family: var(--serif);
    font-size: 1.45rem;
    line-height: 1;
    letter-spacing: -.01em;
    white-space: nowrap;
  }
  .site-header__actions {
    grid-column: 3;
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 0;
    margin-right: -10px;
  }
  .site-header__icon-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    background: none;
    color: inherit;
    font-size: 21px;
    text-decoration: none;
    cursor: pointer;
    transition: color var(--dur) var(--ease);
  }
  .site-header__icon-btn:hover { color: var(--accent); }
  .site-header__count {
    position: absolute;
    top: 5px;
    right: 3px;
    min-width: 17px;
    height: 17px;
    padding: 0 4px;
    border-radius: 999px;
    background: var(--burgundy);
    color: var(--paper);
    font: 500 .64rem/17px var(--sans);
    text-align: center;
  }
  .scheme-burgundy .site-header__count { background: var(--paper); color: var(--burgundy); }
  .site-header__count[hidden] { display: none; }
  .site-header__toggle {
    grid-column: 1;
    grid-row: 1;
    justify-self: start;
    margin-left: -10px;
  }

  /* Mobile: off-canvas navigation panel */
  .site-header .site-header__nav {
    position: fixed;
    top: 0;
    bottom: 0;
    left: 0;
    z-index: 2;
    width: min(360px, 88vw);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    background: var(--paper);
    color: var(--ink);
    box-shadow: 8px 0 40px rgba(20, 30, 24, .18);
    transform: translateX(-102%);
    visibility: hidden;
    transition: transform .35s var(--ease), visibility .35s var(--ease);
  }
  .site-header .site-header__nav.is-open {
    transform: none;
    visibility: visible;
  }
  .site-header__nav-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 64px;
    padding: 0 10px 0 var(--gutter);
    border-bottom: 1px solid var(--line);
  }
  .site-header__nav-title {
    color: var(--burgundy);
    font: 500 var(--fs-eyebrow)/1 var(--sans);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }
  .site-header .site-header__nav .site-header__icon-btn { color: var(--ink); }
  .site-header .site-header__menu {
    list-style: none;
    margin: 0;
    padding: 12px 0;
  }
  .site-header .site-header__nav a,
  .site-header .site-header__nav summary {
    display: block;
    padding: 14px var(--gutter);
    color: var(--forest);
    font-family: var(--serif);
    font-size: 1.6rem;
    line-height: 1.2;
    text-decoration: none;
    cursor: pointer;
  }
  .site-header .site-header__nav a:hover,
  .site-header .site-header__nav summary:hover { color: var(--burgundy); }
  .site-header .site-header__nav a[aria-current="page"] { color: var(--burgundy); }
  .site-header .site-header__dropdown summary { list-style: none; }
  .site-header .site-header__dropdown summary::-webkit-details-marker { display: none; }
  .site-header .site-header__sub { list-style: none; margin: 0 0 8px; padding: 0; }
  .site-header .site-header__sub a {
    padding: 8px var(--gutter) 8px calc(var(--gutter) + 16px);
    font-family: var(--sans);
    font-size: 1rem;
  }
  .site-header .site-header__nav .site-header__account-link a {
    margin-top: 16px;
    border-top: 1px solid var(--line);
    padding-top: 24px;
    font: 500 var(--fs-eyebrow)/1.3 var(--sans);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--ink);
  }
  .site-header__overlay {
    position: fixed;
    inset: 0;
    z-index: 1;
    background: rgba(20, 30, 24, .45);
  }
  .site-header__overlay[hidden] { display: none; }
  body.is-nav-locked { overflow: hidden; }

  @media (max-width: 767px) {
    .site-header__account { display: none; }
  }

  @media (min-width: 768px) {
    .site-header__inner {
      min-height: 84px;
      grid-template-columns: 1fr auto 1fr;
      gap: 32px;
    }
    .site-header__logo { grid-column: 1; justify-self: start; }
    .site-header__wordmark { font-size: 1.7rem; }
    .site-header__toggle,
    .site-header__nav-top,
    .site-header__account-link,
    .site-header__overlay { display: none !important; }
    .site-header .site-header__nav {
      grid-column: 2;
      grid-row: 1;
      position: static;
      width: auto;
      display: flex;
      align-items: center;
      justify-self: center;
      overflow: visible;
      background: none;
      color: inherit;
      box-shadow: none;
      transform: none;
      visibility: visible;
      transition: none;
    }
    .site-header .site-header__menu {
      display: flex;
      align-items: center;
      gap: clamp(20px, 2.6vw, 40px);
      padding: 0;
    }
    .site-header .site-header__menu > li > a,
    .site-header .site-header__menu > li > .site-header__dropdown > summary {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 0;
      color: inherit;
      font: 500 .76rem/1.2 var(--sans);
      letter-spacing: .16em;
      text-transform: uppercase;
    }
    .site-header .site-header__menu > li > a::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      bottom: 4px;
      height: 1px;
      background: currentColor;
      transform: scaleX(0);
      transform-origin: left;
      transition: transform var(--dur) var(--ease);
    }
    .site-header .site-header__menu > li > a:hover,
    .site-header .site-header__menu > li > .site-header__dropdown > summary:hover { color: inherit; }
    .site-header .site-header__menu > li > a:hover::after,
    .site-header .site-header__menu > li > a[aria-current="page"]::after { transform: scaleX(1); }
    .site-header__dropdown { position: relative; }
    .site-header__dropdown summary::after {
      content: "";
      width: 5px;
      height: 5px;
      border-right: 1px solid currentColor;
      border-bottom: 1px solid currentColor;
      transform: translateY(-2px) rotate(45deg);
    }
    .site-header__dropdown[open] summary::after { transform: translateY(1px) rotate(-135deg); }
    .site-header .site-header__dropdown .site-header__sub {
      position: absolute;
      top: calc(100% + 18px);
      left: -20px;
      z-index: 5;
      min-width: 220px;
      margin: 0;
      padding: 10px 0;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--paper);
      box-shadow: var(--shadow-soft);
    }
    .site-header .site-header__dropdown .site-header__sub a {
      display: block;
      padding: 8px 20px;
      color: var(--ink);
      font: 400 .95rem/1.4 var(--sans);
    }
    .site-header__actions { gap: 4px; }
  }
</style>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "cream", "label": "Cream" },
        { "value": "forest", "label": "Dark green" },
        { "value": "burgundy", "label": "Burgundy" }
      ],
      "default": "light"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Sticky header",
      "default": true
    }
  ]
}
{% endschema %}
