{%- liquid
  assign header_id = 'site-nav-' | append: section.id
  assign scheme = section.settings.color_scheme | default: 'light'
  assign menu = section.settings.menu
-%}
<header class="site-header scheme-{{ scheme }}" data-site-header{% if section.settings.sticky %} data-sticky="true"{% endif %}>
  <div class="container site-header__inner">
    <a class="site-header__logo" href="{{ routes.root_url }}">
      {%- if settings.logo -%}
        {{ settings.logo | image_url: width: 600 | image_tag: width: settings.logo_width, loading: 'eager', alt: shop.name, class: 'site-header__logo-img' }}
      {%- else -%}
        <span class="site-header__wordmark">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    <nav class="site-header__nav" id="{{ header_id }}" aria-label="Main" data-nav>
      <div class="site-header__nav-top">
        <span class="site-header__nav-title">Menu</span>
        <button type="button" class="site-header__icon-btn" data-nav-close>
          {%- render 'icon', name: 'close' -%}
          <span class="visually-hidden">Close menu</span>
        </button>
      </div>
      <ul class="site-header__menu">
        {%- for link in menu.links -%}
          <li class="site-header__item">
            {%- if link.links.size > 0 -%}
              <details class="site-header__dropdown">
                <summary>{{ link.title }}</summary>
                <ul class="site-header__sub">
                  {%- for child in link.links -%}
                    <li><a href="{{ child.url }}"{% if child.active %} aria-current="page"{% endif %}>{{ child.title }}</a></li>
                  {%- endfor -%}
                </ul>
              </details>
            {%- else -%}
              <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
            {%- endif -%}
          </li>
        {%- endfor -%}
        {%- if shop.customer_accounts_enabled -%}
          <li class="site-header__item site-header__account-link">
            <a href="{{ routes.account_login_url }}">Account</a>
          </li>
        {%- endif -%}
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="site-header__icon-btn" href="{{ routes.search_url }}">
        {%- render 'icon', name: 'search' -%}
        <span class="visually-hidden">Search</span>
      </a>
      {%- if shop.customer_accounts_enabled -%}
        <a class="site-header__icon-btn site-header__account" href="{{ routes.account_login_url }}">
          {%- render 'icon', name: 'account' -%}
          <span class="visually-hidden">Account</span>
        </a>
      {%- endif -%}
      <a class="site-header__icon-btn site-header__cart" href="{{ routes.cart_url }}" data-cart-open>
        {%- render 'icon', name: 'cart' -%}
        <span class="visually-hidden">Cart</span>
        <span class="site-header__count" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
      <button type="button" class="site-header__icon-btn site-header__toggle" data-nav-open aria-expanded="false" aria-controls="{{ header_id }}">
        {%- render 'icon', name: 'menu' -%}
        <span class="visually-hidden">Open menu</span>
      </button>
    </div>
  </div>
  <div class="site-header__overlay" data-nav-overlay hidden></div>
</header>

<style>
  .shopify-section:has(> .site-header[data-sticky="true"]) {
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .site-header {
    position: relative;
    z-index: 50;
    border-bottom: 1px solid var(--line);
    transition: box-shadow .2s ease;
  }
  .site-header.is-scrolled {
    box-shadow: 0 2px 16px rgba(26, 58, 42, .08);
  }
  .site-header__inner {
    min-height: 64px;
    padding-block: 12px;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 16px;
  }
  .site-header__logo {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: inherit;
  }
  .site-header__logo-img { height: auto; }
  .site-header__wordmark {
    font-family: var(--serif);
    font-size: 1.4rem;
    line-height: 1;
  }
  .site-header__actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 2px;
  }
  .site-header__icon-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: none;
    color: inherit;
    font-size: 22px;
    text-decoration: none;
    cursor: pointer;
  }
  .site-header__icon-btn:hover { color: var(--burgundy); }
  .site-header__count {
    position: absolute;
    top: 2px;
    right: 0;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    border-radius: 999px;
    background: var(--burgundy);
    color: var(--paper);
    font: 600 .7rem/18px var(--sans);
    text-align: center;
  }
  .site-header__count[hidden] { display: none; }
  .site-header__toggle,
  .site-header__nav-top,
  .site-header__account-link { display: none; }

  /* Mobile: off-canvas navigation panel */
  .site-header .site-header__nav {
    position: fixed;
    top: 0;
    bottom: 0;
    left: 0;
    z-index: 2;
    width: min(340px, 86vw);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    background: var(--paper);
    color: var(--ink);
    box-shadow: 4px 0 24px rgba(0, 0, 0, .15);
    transform: translateX(-102%);
    visibility: hidden;
    transition: transform .28s ease, visibility .28s ease;
  }
  .site-header .site-header__nav.is-open {
    transform: none;
    visibility: visible;
  }
  .site-header .site-header__nav-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px var(--gutter);
    border-bottom: 1px solid var(--line);
  }
  .site-header .site-header__nav-title {
    font-family: var(--serif);
    font-size: 1.2rem;
  }
  .site-header .site-header__nav .site-header__icon-btn { color: var(--ink); }
  .site-header .site-header__menu {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-header .site-header__nav a,
  .site-header .site-header__nav summary {
    display: block;
    padding: 14px var(--gutter);
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
    font-size: 1.05rem;
    cursor: pointer;
  }
  .site-header .site-header__dropdown summary { list-style: none; }
  .site-header .site-header__dropdown summary::-webkit-details-marker { display: none; }
  .site-header .site-header__sub { list-style: none; margin: 0; padding: 0; background: var(--cream); }
  .site-header .site-header__sub a {
    padding-left: calc(var(--gutter) * 2);
    font-size: 1rem;
  }
  .site-header__overlay {
    position: fixed;
    inset: 0;
    z-index: 1;
    background: rgba(29, 29, 27, .4);
  }
  .site-header__overlay[hidden] { display: none; }
  body.is-nav-locked { overflow: hidden; }

  @media (min-width: 768px) {
    .site-header__inner {
      grid-template-columns: 1fr auto 1fr;
      gap: 32px;
    }
    .site-header__nav {
      display: flex;
      align-items: center;
      justify-self: center;
    }
    .site-header .site-header__nav {
      position: static;
      width: auto;
      overflow: visible;
      background: none;
      color: inherit;
      box-shadow: none;
      transform: none;
      visibility: visible;
    }
    .site-header .site-header__menu {
      display: flex;
      align-items: center;
      gap: 28px;
    }
    .site-header .site-header__menu > li > a,
    .site-header .site-header__menu > li > .site-header__dropdown > summary {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 0;
      border: 0;
      color: inherit;
      font-size: 1rem;
    }
    .site-header .site-header__sub a {
      padding: 8px 16px;
      font-size: .95rem;
    }
    .site-header__dropdown { position: relative; }
    .site-header__dropdown summary::after {
      content: "";
      width: 6px;
      height: 6px;
      border-right: 1.5px solid currentColor;
      border-bottom: 1.5px solid currentColor;
      transform: translateY(-2px) rotate(45deg);
    }
    .site-header__dropdown[open] summary::after {
      transform: translateY(2px) rotate(-135deg);
    }
    .site-header__dropdown[open] .site-header__sub,
    .site-header .site-header__dropdown .site-header__sub {
      position: absolute;
      top: calc(100% + 14px);
      left: -16px;
      z-index: 5;
      min-width: 200px;
      padding: 8px 0;
      border: 1px solid var(--line);
      border-radius: 12px;
      background: var(--paper);
      box-shadow: 0 12px 32px rgba(0, 0, 0, .12);
    }
    .site-header .site-header__dropdown .site-header__sub a {
      display: block;
      color: var(--ink);
    }
    .site-header__account-link { display: none !important; }
    .site-header__overlay { display: none !important; }
  }

  @media (max-width: 767px) {
    .site-header__toggle { display: inline-flex; }
    .site-header__nav-top { display: flex; }
    .site-header__account-link { display: block; }
    .site-header__account { display: none; }
  }
</style>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "cream", "label": "Cream" },
        { "value": "forest", "label": "Dark green" },
        { "value": "burgundy", "label": "Burgundy" }
      ],
      "default": "light"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Sticky header",
      "default": true
    }
  ]
}
{% endschema %}
