{%- assign item_count = section.blocks.size -%}
<section class="section trust-bar {% render 'section-classes', settings: section.settings %}">
  <div class="container">
    <ul class="trust-bar__list" style="--items: {{ item_count }};" role="list">
      {%- for block in section.blocks -%}
        <li class="trust-bar__item" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != blank -%}
            <span class="trust-bar__icon">{{ block.settings.icon | image_url: width: 80 | image_tag: loading: 'lazy', alt: '' }}</span>
          {%- elsif block.settings.builtin_icon != 'none' and block.settings.builtin_icon != blank -%}
            <span class="trust-bar__icon">{%- render 'icon', name: block.settings.builtin_icon -%}</span>
          {%- endif -%}
          <span class="trust-bar__copy">
            <span class="trust-bar__text">{{ block.settings.text }}</span>
            {%- if block.settings.subtext != blank -%}
              <span class="trust-bar__sub">{{ block.settings.subtext }}</span>
            {%- endif -%}
          </span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

<style>
  .trust-bar.section { padding-block: 28px; border-bottom: 1px solid var(--rule); }
  .trust-bar.section--pad-m { padding-block: 40px; }
  .trust-bar.section--pad-l { padding-block: 56px; }
  .trust-bar__list {
    display: grid;
    grid-template-columns: repeat(min(var(--items, 3), 3), minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .trust-bar__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 4px 10px;
    text-align: center;
  }
  .trust-bar__item + .trust-bar__item { border-left: 1px solid var(--rule); }
  .trust-bar__icon {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 28px;
    height: 28px;
    color: var(--accent);
    font-size: 26px;
  }
  .trust-bar__icon img { width: 100%; height: 100%; object-fit: contain; }
  .trust-bar__icon .icon { stroke-width: 1.2; }
  .trust-bar__copy { display: grid; gap: 2px; }
  .trust-bar__text {
    font: 500 .68rem/1.4 var(--sans);
    letter-spacing: .16em;
    text-transform: uppercase;
  }
  .trust-bar__sub { font-size: var(--fs-small); color: var(--fg-muted); }
  @media (max-width: 767px) {
    .trust-bar__list { grid-template-columns: repeat(min(var(--items, 3), 2), minmax(0, 1fr)); row-gap: 24px; }
    .trust-bar__list:has(> :nth-child(3):last-child) { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .trust-bar__list:not(:has(> :nth-child(3):last-child)) .trust-bar__item:nth-child(odd) { border-left: 0; }
  }
  @media (min-width: 768px) {
    .trust-bar__list { grid-template-columns: repeat(var(--items, 3), minmax(0, 1fr)); }
    .trust-bar__item { flex-direction: row; gap: 16px; padding: 6px 24px; text-align: left; }
    .trust-bar__text { font-size: .72rem; }
  }
</style>

{% schema %}
{
  "name": "Trust bar",
  "max_blocks": 6,
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "cream",
          "label": "Cream"
        },
        {
          "value": "forest",
          "label": "Dark green"
        },
        {
          "value": "burgundy",
          "label": "Burgundy"
        }
      ],
      "default": "cream"
    },
    {
      "type": "select",
      "id": "padding",
      "label": "Spacing",
      "options": [
        {
          "value": "s",
          "label": "Small"
        },
        {
          "value": "m",
          "label": "Medium"
        },
        {
          "value": "l",
          "label": "Large"
        }
      ],
      "default": "s"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "select",
          "id": "builtin_icon",
          "label": "Icon",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "leaf",
              "label": "Leaf"
            },
            {
              "value": "honeycomb",
              "label": "Honeycomb"
            },
            {
              "value": "jar",
              "label": "Honey jar"
            },
            {
              "value": "cup",
              "label": "Tea cup"
            },
            {
              "value": "sprout",
              "label": "Sprout"
            },
            {
              "value": "truck",
              "label": "Delivery"
            },
            {
              "value": "cash",
              "label": "Cash"
            },
            {
              "value": "hand",
              "label": "Care"
            }
          ],
          "default": "leaf"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Custom icon (optional)",
          "info": "Replaces the icon above"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Item text"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Small text (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust bar",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "text": "Item text",
            "builtin_icon": "honeycomb"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Item text",
            "builtin_icon": "leaf"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Item text",
            "builtin_icon": "truck"
          }
        }
      ]
    }
  ]
}
{% endschema %}
