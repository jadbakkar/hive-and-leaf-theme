<div>
  <h1>{{ section.settings.heading | default: shop.name }}</h1>
  {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}
</div>

{% schema %}
{
  "name": "Blank page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "subheading", "label": "Subheading" }
  ]
}
{% endschema %}
