<style>
  .page-hero__title { font-size: clamp(2.5rem, 6vw, 4.5rem); }
  .page-hero__sub { max-width: 640px; margin: 0 auto 40px; color: var(--muted); font-size: 1.15rem; }
  .page-hero--left { text-align: left; }
  .page-hero--center .page-hero__eyebrow { justify-content: center; }
  .page-hero--left .page-hero__sub { margin-left: 0; }
  .page-hero__media { position: relative; width: 100%; border-radius: 12px; overflow: hidden; background: var(--cream); aspect-ratio: 16 / 9; }
  .page-hero__media .img-fill { height: 100%; }
</style>

<section class="section page-hero page-hero--{{ section.settings.alignment | default: 'center' }} {% render 'section-classes', settings: section.settings %}">
  <div class="container">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow page-hero__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h1 class="page-hero__title">{{ section.settings.heading }}</h1>
    {% if section.settings.subheading != blank %}
      <p class="page-hero__sub">{{ section.settings.subheading }}</p>
    {% endif %}

    {% if section.settings.image != blank %}
      <div class="page-hero__media">
        {{ section.settings.image | image_url: width: 1200 | image_tag: class: 'img-fill', loading: 'lazy' }}
      </div>
    {% else %}
      <div class="img-blank img-blank--wide" data-label="Image"></div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Page hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "info": "Small label above the heading",
      "default": "Short label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Page title"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Supporting text goes here."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "cream",
          "label": "Cream"
        },
        {
          "value": "forest",
          "label": "Dark green"
        },
        {
          "value": "burgundy",
          "label": "Burgundy"
        }
      ],
      "default": "light"
    },
    {
      "type": "select",
      "id": "padding",
      "label": "Spacing",
      "options": [
        {
          "value": "s",
          "label": "Small"
        },
        {
          "value": "m",
          "label": "Medium"
        },
        {
          "value": "l",
          "label": "Large"
        }
      ],
      "default": "m"
    }
  ],
  "presets": [
    {
      "name": "Page hero"
    }
  ]
}
{% endschema %}
