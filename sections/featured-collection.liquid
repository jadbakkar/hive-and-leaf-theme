{%- liquid
  assign collection = section.settings.collection
  if collection != blank
    assign view_all_url = collection.url
  else
    assign view_all_url = routes.all_products_collection_url
  endif
-%}
<section class="section featured-collection {% render 'section-classes', settings: section.settings %}" style="--columns: {{ section.settings.columns }};">
  <div class="container">
    <div class="section-header">
      <div class="section-header__titles">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow eyebrow--rule">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="section-header__title">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="lede">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.link_label != blank -%}
        <a class="link-arrow featured-collection__link" href="{{ view_all_url }}">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>

    <ul class="featured-collection__grid" role="list">
      {%- if collection != blank -%}
        {%- for product in collection.products limit: section.settings.limit -%}
          <li class="featured-collection__item">{% render 'product-card', product: product %}</li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <li class="featured-collection__item">
            <div class="product-card product-card--placeholder">
              <div class="card-media">
                <div class="img-blank img-blank--portrait" data-label="Product image"></div>
              </div>
              <div class="product-card__body">
                <h3 class="product-card__title">Product title</h3>
                <div class="price"><span class="price__current">&mdash;</span></div>
              </div>
            </div>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>

<style>
  .featured-collection__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .featured-collection__item { min-width: 0; }
  @media (max-width: 767px) {
    /* Swipeable row on phones; the next card peeks in so the gesture is obvious. */
    .featured-collection__grid {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 68%;
      gap: 16px;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
    }
    .featured-collection__grid::-webkit-scrollbar { display: none; }
    .featured-collection__item { scroll-snap-align: start; }
  }
  @media (min-width: 768px) {
    .featured-collection__grid { grid-template-columns: repeat(var(--columns, 4), minmax(0, 1fr)); gap: 56px 24px; }
  }
</style>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "info": "Small label above the heading",
      "default": "Short label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Section heading"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Intro text (optional)"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "View all"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Number of products",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Desktop columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "cream",
          "label": "Cream"
        },
        {
          "value": "forest",
          "label": "Dark green"
        },
        {
          "value": "burgundy",
          "label": "Burgundy"
        }
      ],
      "default": "light"
    },
    {
      "type": "select",
      "id": "padding",
      "label": "Spacing",
      "options": [
        {
          "value": "s",
          "label": "Small"
        },
        {
          "value": "m",
          "label": "Medium"
        },
        {
          "value": "l",
          "label": "Large"
        }
      ],
      "default": "m"
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
