<section class="section featured-collection {% render 'section-classes', settings: section.settings %}" style="--columns: {{ section.settings.columns }};">
<div class="container">
  <h2>{{ section.settings.heading }}</h2>
  {% if section.settings.collection != blank %}
    <div class="featured-collection__grid">
      {% for product in section.settings.collection.products limit: section.settings.limit %}
        {% render 'product-card', product: product %}
      {% endfor %}
    </div>
  {% else %}
    <div class="featured-collection__grid">
      {% for i in (1..4) %}
        <div class="product-card">
          <div class="card-media">
            <div class="img-blank img-blank--portrait"></div>
          </div>
          <h3>Product title</h3>
          <p>&mdash;</p>
        </div>
      {% endfor %}
    </div>
  {% endif %}
</div>
</section>

<style>
  .featured-collection__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 16px; }
  @media (min-width: 768px) {
    .featured-collection__grid { grid-template-columns: repeat(var(--columns, 4), minmax(0, 1fr)); gap: 40px 24px; }
  }
</style>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Section heading"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Number of products",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Desktop columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "cream",
          "label": "Cream"
        },
        {
          "value": "forest",
          "label": "Dark green"
        },
        {
          "value": "burgundy",
          "label": "Burgundy"
        }
      ],
      "default": "light"
    },
    {
      "type": "select",
      "id": "padding",
      "label": "Spacing",
      "options": [
        {
          "value": "s",
          "label": "Small"
        },
        {
          "value": "m",
          "label": "Medium"
        },
        {
          "value": "l",
          "label": "Large"
        }
      ],
      "default": "m"
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
