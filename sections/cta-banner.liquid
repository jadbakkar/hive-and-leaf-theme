<style>
  .cta-banner { text-align: center; }
  .cta-banner__title { font-size: clamp(2.25rem, 5vw, 3.5rem); }
  .cta-banner__text { max-width: 560px; margin: 0 auto 32px; color: var(--muted); font-size: 1.1rem; }
</style>

{% assign button_href = section.settings.button_link | default: routes.all_products_collection_url %}

<section class="section cta-banner {% render 'section-classes', settings: section.settings %}">
  <div class="container">
    <h2 class="cta-banner__title">{{ section.settings.heading }}</h2>
    {% if section.settings.text != blank %}
      <p class="cta-banner__text">{{ section.settings.text }}</p>
    {% endif %}
    {% if section.settings.button_label != blank %}
      <a class="btn" href="{{ button_href }}">{{ section.settings.button_label }}</a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "CTA banner",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Closing heading" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Supporting text goes here." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Button" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "cream", "label": "Cream" },
        { "value": "forest", "label": "Dark green" },
        { "value": "burgundy", "label": "Burgundy" }
      ],
      "default": "forest"
    },
    {
      "type": "select",
      "id": "padding",
      "label": "Spacing",
      "options": [
        { "value": "s", "label": "Small" },
        { "value": "m", "label": "Medium" },
        { "value": "l", "label": "Large" }
      ],
      "default": "m"
    }
  ],
  "presets": [
    { "name": "CTA banner" }
  ]
}
{% endschema %}
