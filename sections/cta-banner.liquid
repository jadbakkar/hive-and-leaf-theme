{%- assign button_href = section.settings.button_link | default: routes.all_products_collection_url -%}
<section class="section cta-banner {% render 'section-classes', settings: section.settings %}">
  <div class="container">
    <div class="cta-banner__inner">
      <span class="cta-banner__motif" aria-hidden="true">{%- render 'icon', name: 'sprout' -%}</span>
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="cta-banner__title display">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="cta-banner__text lede">{{ section.settings.text }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <div class="btn-row btn-row--center">
          <a class="btn" href="{{ button_href }}">{{ section.settings.button_label }}</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .cta-banner__inner { max-width: 880px; margin-inline: auto; text-align: center; }
  .cta-banner__motif { display: block; width: max-content; margin: 0 auto 20px; color: var(--accent); font-size: 30px; }
  .cta-banner__motif .icon { stroke-width: 1.1; }
  .cta-banner .eyebrow { justify-content: center; }
  .cta-banner__title { margin-bottom: 24px; font-size: clamp(2.5rem, 1.6rem + 3.6vw, 4.5rem); }
  .cta-banner__text { margin: 0 auto 40px; }
</style>

{% schema %}
{
  "name": "CTA banner",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "info": "Small label above the heading",
      "default": "Short label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Closing heading"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Supporting text goes here."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Button"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Defaults to all products"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "cream",
          "label": "Cream"
        },
        {
          "value": "forest",
          "label": "Dark (primary)"
        },
        {
          "value": "burgundy",
          "label": "Accent"
        }
      ],
      "default": "forest"
    },
    {
      "type": "select",
      "id": "padding",
      "label": "Spacing",
      "options": [
        {
          "value": "s",
          "label": "Small"
        },
        {
          "value": "m",
          "label": "Medium"
        },
        {
          "value": "l",
          "label": "Large"
        }
      ],
      "default": "m"
    }
  ],
  "presets": [
    {
      "name": "CTA banner"
    }
  ]
}
{% endschema %}
