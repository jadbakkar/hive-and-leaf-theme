<section class="section collections-list {% render 'section-classes', settings: section.settings %}">
  <div class="container">
    <header class="page-header page-header--rule">
      <div class="page-header__titles">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow eyebrow--rule">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h1 class="page-header__title">{{ section.settings.heading }}</h1>
        {%- if section.settings.text != blank -%}
          <p class="lede">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>
      {%- if collections.size > 0 -%}
        <div class="page-header__aside">
          <p class="meta"><span>{{ collections.size }} {% if collections.size == 1 %}collection{% else %}collections{% endif %}</span></p>
        </div>
      {%- endif -%}
    </header>

    {%- if collections.size > 0 -%}
      <ul class="collections-list__grid" role="list">
        {%- for collection in collections -%}
          <li>
            <a href="{{ collection.url }}" class="collection-card">
              <span class="collection-card__media media-frame">
                {%- if collection.image -%}
                  {{ collection.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: '', sizes: '(min-width: 990px) 33vw, 50vw', widths: '400, 600, 800, 1000' }}
                {%- else -%}
                  <span class="img-blank" data-label="Collection"></span>
                {%- endif -%}
              </span>
              <span class="collection-card__body">
                <span class="collection-card__title h3">{{ collection.title }}</span>
                <span class="collection-card__count">{{ collection.products_count }} {% if collection.products_count == 1 %}product{% else %}products{% endif %}</span>
              </span>
              <span class="link-arrow collection-card__arrow" aria-hidden="true"></span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <div class="empty-state">
        <span class="icon-badge">{% render 'icon', name: 'jar' %}</span>
        <h2 class="empty-state__title h3">No collections yet</h2>
        <p class="lede">Collections will appear here as soon as they are published.</p>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  .collections-list { padding-top: clamp(40px, 5vw, 72px); }
  .collections-list__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px 16px; margin: 0; padding: 0; list-style: none; }
  @media (min-width: 990px) {
    .collections-list__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 64px 24px; }
    /* Exactly four collections: one row of four instead of three plus an orphan. */
    .collections-list__grid:has(> li:nth-child(4):last-child) { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  .collection-card { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 0 16px; text-decoration: none; }
  .collection-card__media { grid-column: 1 / -1; display: block; margin-bottom: 20px; }
  .collection-card__media img { transition: transform .8s var(--ease); }
  .collection-card__body { display: grid; gap: 6px; }
  .collection-card__title { margin: 0; }
  .collection-card__count { color: var(--fg-muted); font-size: var(--fs-small); }
  .collection-card__arrow { padding-bottom: 6px; }
  @media (hover: hover) {
    .collection-card:hover .collection-card__media img { transform: scale(1.03); }
    .collection-card:hover .collection-card__title { color: var(--accent); }
    .collection-card:hover .collection-card__arrow::after { transform: translateX(4px); }
  }
  @media (max-width: 599px) { .collection-card__arrow { display: none; } }
</style>

{% schema %}
{
  "name": "Collections list",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Collections"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Intro text",
      "default": "Supporting text goes here."
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "cream",
          "label": "Cream"
        },
        {
          "value": "forest",
          "label": "Dark green"
        },
        {
          "value": "burgundy",
          "label": "Burgundy"
        }
      ],
      "default": "light"
    }
  ]
}
{% endschema %}
