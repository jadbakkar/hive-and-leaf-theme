<section class="section scheme-{{ section.settings.color_scheme | default: 'light' }}">
<div class="container">
  <h1>Collections</h1>
  <div class="grid">
    {% for collection in collections %}
      <a href="{{ collection.url }}" class="product-card">
        <div class="card-media">
          {% if collection.featured_image %}
            {{ collection.featured_image | image_url: width: 600 | image_tag: loading: 'lazy' }}
          {% else %}
            <div class="img-blank img-blank--portrait"></div>
          {% endif %}
        </div>
        <h3>{{ collection.title }}</h3>
      </a>
    {% endfor %}
  </div>
</div>
</section>

{% schema %}
{
  "name": "Collections list",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "cream",
          "label": "Cream"
        },
        {
          "value": "forest",
          "label": "Dark green"
        },
        {
          "value": "burgundy",
          "label": "Burgundy"
        }
      ],
      "default": "light"
    }
  ]
}
{% endschema %}
