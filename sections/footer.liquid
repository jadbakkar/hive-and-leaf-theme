{%- liquid
  assign scheme = section.settings.color_scheme | default: 'forest'

  # WhatsApp: digits only (spaces, +, -, brackets allowed) becomes a wa.me link; anything else is used as a URL.
  assign wa = settings.social_whatsapp | strip
  assign wa_digits = wa | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
  assign wa_is_number = false
  if wa_digits != blank
    assign wa_is_number = true
    assign wa_chars = wa_digits | split: ''
    for c in wa_chars
      unless '0123456789' contains c
        assign wa_is_number = false
      endunless
    endfor
  endif
  if wa_is_number
    assign wa_url = 'https://wa.me/' | append: wa_digits
  elsif wa != blank
    assign wa_url = wa
  endif
  assign has_social = false
  if settings.social_instagram != blank or settings.social_facebook != blank or settings.social_tiktok != blank or wa_url != blank
    assign has_social = true
  endif
-%}
<footer class="site-footer scheme-{{ scheme }}">
  <div class="container">
    <div class="site-footer__top">
      {%- if section.settings.show_brand -%}
        <div class="site-footer__brand">
          <a class="site-footer__wordmark" href="{{ routes.root_url }}">{{ shop.name }}</a>
          {%- if section.settings.brand_text != blank -%}
            <p class="site-footer__brand-text">{{ section.settings.brand_text }}</p>
          {%- endif -%}
          {%- if has_social -%}
            <ul class="site-footer__social" role="list">
              {%- if settings.social_instagram != blank -%}
                <li><a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram (opens in a new tab)">{% render 'icon', name: 'instagram' %}</a></li>
              {%- endif -%}
              {%- if settings.social_facebook != blank -%}
                <li><a href="{{ settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook (opens in a new tab)">{% render 'icon', name: 'facebook' %}</a></li>
              {%- endif -%}
              {%- if settings.social_tiktok != blank -%}
                <li><a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok (opens in a new tab)">{% render 'icon', name: 'tiktok' %}</a></li>
              {%- endif -%}
              {%- if wa_url != blank -%}
                <li><a href="{{ wa_url }}" target="_blank" rel="noopener" aria-label="WhatsApp (opens in a new tab)">{% render 'icon', name: 'whatsapp' %}</a></li>
              {%- endif -%}
            </ul>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="site-footer__grid">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'menu' -%}
              <div class="site-footer__col" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <h2 class="site-footer__heading">{{ block.settings.heading }}</h2>
                {%- endif -%}
                {%- if block.settings.menu.links.size > 0 -%}
                  <ul class="site-footer__links" role="list">
                    {%- for link in block.settings.menu.links -%}
                      <li><a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a></li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </div>

            {%- when 'text' -%}
              <div class="site-footer__col" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <h2 class="site-footer__heading">{{ block.settings.heading }}</h2>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="site-footer__text">{{ block.settings.text }}</div>
                {%- endif -%}
              </div>

            {%- when 'newsletter' -%}
              <div class="site-footer__col site-footer__col--newsletter" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <h2 class="site-footer__heading">{{ block.settings.heading }}</h2>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p class="site-footer__text">{{ block.settings.text }}</p>
                {%- endif -%}
                {%- form 'customer', class: 'site-footer__form' -%}
                  {%- if form.posted_successfully? -%}
                    <p class="site-footer__message" role="status">Thanks for subscribing.</p>
                  {%- elsif form.errors -%}
                    <p class="site-footer__message" role="alert">{{ form.errors | default_errors }}</p>
                  {%- endif -%}
                  <input type="hidden" name="contact[tags]" value="newsletter">
                  <label class="visually-hidden" for="footer-email-{{ block.id }}">Email address</label>
                  <div class="site-footer__field">
                    <input type="email" name="contact[email]" id="footer-email-{{ block.id }}" placeholder="Email address" autocomplete="email" required>
                    <button type="submit" class="site-footer__submit">
                      {%- render 'icon', name: 'arrow-right' -%}
                      <span class="visually-hidden">Subscribe</span>
                    </button>
                  </div>
                {%- endform -%}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="site-footer__bottom">
      <p class="site-footer__copy">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
      {%- unless section.settings.show_brand -%}
        {%- if has_social -%}
          <ul class="site-footer__social" role="list">
            {%- if settings.social_instagram != blank -%}
              <li><a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram (opens in a new tab)">{% render 'icon', name: 'instagram' %}</a></li>
            {%- endif -%}
            {%- if settings.social_facebook != blank -%}
              <li><a href="{{ settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook (opens in a new tab)">{% render 'icon', name: 'facebook' %}</a></li>
            {%- endif -%}
            {%- if settings.social_tiktok != blank -%}
              <li><a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok (opens in a new tab)">{% render 'icon', name: 'tiktok' %}</a></li>
            {%- endif -%}
            {%- if wa_url != blank -%}
              <li><a href="{{ wa_url }}" target="_blank" rel="noopener" aria-label="WhatsApp (opens in a new tab)">{% render 'icon', name: 'whatsapp' %}</a></li>
            {%- endif -%}
          </ul>
        {%- endif -%}
      {%- endunless -%}
      <a class="site-footer__top-link" href="#MainContent">Back to top</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    padding: clamp(64px, 8vw, 104px) 0 28px;
    font-size: .95rem;
  }
  /* A footer that follows a section of the same scheme gets a hairline so the two don't merge. */
  main:has(> .shopify-section:last-child > .scheme-forest) ~ .shopify-section > .site-footer.scheme-forest,
  main:has(> .shopify-section:last-child > .scheme-burgundy) ~ .shopify-section > .site-footer.scheme-burgundy,
  main:has(> .shopify-section:last-child > .scheme-cream) ~ .shopify-section > .site-footer.scheme-cream,
  main:has(> .shopify-section:last-child > .scheme-light) ~ .shopify-section > .site-footer.scheme-light {
    /* hairline drawn by ::before below */
    --footer-seam: 1;
  }
  .site-footer::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    width: min(var(--container), 100% - 2 * var(--gutter));
    border-top: 1px solid var(--rule);
    transform: translateX(-50%);
    opacity: var(--footer-seam, 0);
  }
  .site-footer__top {
    display: grid;
    gap: 48px;
    padding-bottom: clamp(48px, 6vw, 80px);
  }
  .site-footer__wordmark {
    display: inline-block;
    margin-bottom: 16px;
    color: var(--heading);
    font: var(--heading-weight, 400) clamp(1.9rem, 1.5rem + 1.4vw, 2.6rem)/1.05 var(--serif);
    letter-spacing: -.02em;
    text-decoration: none;
  }
  .site-footer__wordmark:hover { color: var(--heading) !important; }
  .site-footer__brand-text { max-width: 34ch; margin: 0; color: var(--fg-muted); }
  .site-footer__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px 24px;
  }
  .site-footer__col--newsletter { grid-column: 1 / -1; }
  .site-footer__heading {
    margin: 0 0 18px;
    color: var(--eyebrow);
    font: 500 var(--fs-eyebrow)/1.3 var(--sans);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }
  .site-footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .site-footer__links a,
  .site-footer__top-link {
    color: var(--fg-muted);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }
  .site-footer a.site-footer__top-link:hover,
  .site-footer .site-footer__links a:hover { color: var(--fg); opacity: 1; }
  .site-footer__text { color: var(--fg-muted); }
  .site-footer__text p { margin: 0 0 6px; }
  .site-footer__text p:last-child { margin-bottom: 0; }
  .site-footer__form { margin-top: 20px; }
  .site-footer__field {
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--field-border);
    transition: border-color var(--dur) var(--ease);
  }
  .site-footer__field:focus-within { border-color: var(--fg); }
  .site-footer__field input {
    flex: 1 1 auto;
    min-width: 0;
    min-height: 48px;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
  }
  .site-footer__field input:focus-visible { outline: none; }
  .site-footer__field:has(input:focus-visible) { outline: 2px solid var(--honey-pale); outline-offset: 4px; }
  .site-footer__field input::placeholder { color: var(--fg-muted); opacity: 1; }
  .site-footer__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font-size: 20px;
    cursor: pointer;
    transition: transform var(--dur) var(--ease);
  }
  .site-footer__submit:hover { transform: translateX(3px); }
  .site-footer__message { margin: 0 0 10px; font-size: .9rem; }
  .site-footer__social {
    display: flex;
    gap: 8px;
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
  }
  .site-footer__social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    font-size: 17px;
    text-decoration: none;
    transition: border-color var(--dur) var(--ease);
  }
  .site-footer .site-footer__social a:hover { border-color: currentColor; color: inherit; opacity: 1; }
  .site-footer__bottom .site-footer__social { margin: 0; }
  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 24px;
    border-top: 1px solid var(--rule);
    font-size: .8rem;
    letter-spacing: .04em;
  }
  .site-footer__copy { margin: 0; color: var(--fg-muted); }

  @media (min-width: 768px) {
    .site-footer__grid { display: flex; flex-wrap: wrap; gap: 40px 32px; }
    .site-footer__col { flex: 1 1 130px; }
    .site-footer__col--newsletter { flex: 2 1 240px; max-width: 380px; }
  }
  @media (min-width: 1024px) {
    .site-footer__top:has(.site-footer__brand) { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 64px; }
  }
</style>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "cream",
          "label": "Cream"
        },
        {
          "value": "forest",
          "label": "Dark green"
        },
        {
          "value": "burgundy",
          "label": "Burgundy"
        }
      ],
      "default": "forest"
    },
    {
      "type": "checkbox",
      "id": "show_brand",
      "label": "Show brand column",
      "default": true
    },
    {
      "type": "textarea",
      "id": "brand_text",
      "label": "Brand text",
      "default": "Short brand description goes here."
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Link list",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Newsletter heading"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        {
          "type": "menu",
          "settings": {
            "heading": "Shop",
            "menu": "main-menu"
          }
        },
        {
          "type": "menu",
          "settings": {
            "heading": "Info",
            "menu": "footer"
          }
        },
        {
          "type": "text",
          "settings": {
            "heading": "Contact",
            "text": "<p>Beirut, Lebanon</p><p>Cash on delivery available</p>"
          }
        },
        {
          "type": "newsletter",
          "settings": {
            "heading": "Newsletter heading",
            "text": "Short newsletter description goes here."
          }
        }
      ]
    }
  ]
}
{% endschema %}
