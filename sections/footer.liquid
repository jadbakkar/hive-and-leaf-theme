<footer class="site-footer">
  <div class="container site-footer__inner">
    <p class="site-footer__name">{{ shop.name }}</p>

    <nav class="site-footer__nav" aria-label="Footer">
      {% for link in section.settings.menu.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </nav>

    <p class="site-footer__copy">© {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--burgundy);
    color: var(--paper);
    padding: 48px 0;
  }
  .site-footer a {
    color: var(--paper);
  }
  .site-footer__inner {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .site-footer__name {
    margin: 0;
    font-family: var(--serif);
    font-size: 1.4rem;
  }
  .site-footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 24px;
  }
  .site-footer__copy {
    margin: 0;
    font-size: .9rem;
    opacity: .8;
  }
</style>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "footer"
    }
  ],
  "presets": [
    {
      "name": "Footer"
    }
  ]
}
{% endschema %}
