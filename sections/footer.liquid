{%- liquid
  assign scheme = section.settings.color_scheme | default: 'forest'

  # WhatsApp: digits only (spaces, +, -, brackets allowed) becomes a wa.me link; anything else is used as a URL.
  assign wa = settings.social_whatsapp | strip
  assign wa_digits = wa | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
  assign wa_is_number = false
  if wa_digits != blank
    assign wa_is_number = true
    assign wa_chars = wa_digits | split: ''
    for c in wa_chars
      unless '0123456789' contains c
        assign wa_is_number = false
      endunless
    endfor
  endif
  if wa_is_number
    assign wa_url = 'https://wa.me/' | append: wa_digits
  elsif wa != blank
    assign wa_url = wa
  endif
  assign has_social = false
  if settings.social_instagram != blank or settings.social_facebook != blank or settings.social_tiktok != blank or wa_url != blank
    assign has_social = true
  endif
-%}
<footer class="site-footer scheme-{{ scheme }}">
  <div class="container">
    <div class="site-footer__grid">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            <div class="site-footer__col" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h2 class="site-footer__heading">{{ block.settings.heading }}</h2>
              {%- endif -%}
              {%- if block.settings.menu.links.size > 0 -%}
                <ul class="site-footer__links">
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>

          {%- when 'text' -%}
            <div class="site-footer__col" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h2 class="site-footer__heading">{{ block.settings.heading }}</h2>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="site-footer__text">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>

          {%- when 'newsletter' -%}
            <div class="site-footer__col site-footer__col--newsletter" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h2 class="site-footer__heading">{{ block.settings.heading }}</h2>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="site-footer__text">{{ block.settings.text }}</p>
              {%- endif -%}
              {%- form 'customer', class: 'site-footer__form' -%}
                {%- if form.posted_successfully? -%}
                  <p class="site-footer__message" role="status">Thanks for subscribing.</p>
                {%- elsif form.errors -%}
                  <p class="site-footer__message" role="alert">{{ form.errors | default_errors }}</p>
                {%- endif -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <label class="visually-hidden" for="footer-email-{{ block.id }}">Email address</label>
                <input type="email" name="contact[email]" id="footer-email-{{ block.id }}" placeholder="Email address" autocomplete="email" required>
                <button type="submit" class="btn">Subscribe</button>
              {%- endform -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="site-footer__bottom">
      {%- if has_social -%}
        <ul class="site-footer__social">
          {%- if settings.social_instagram != blank -%}
            <li><a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a></li>
          {%- endif -%}
          {%- if settings.social_facebook != blank -%}
            <li><a href="{{ settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook">{% render 'icon', name: 'facebook' %}</a></li>
          {%- endif -%}
          {%- if settings.social_tiktok != blank -%}
            <li><a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">{% render 'icon', name: 'tiktok' %}</a></li>
          {%- endif -%}
          {%- if wa_url != blank -%}
            <li><a href="{{ wa_url }}" target="_blank" rel="noopener" aria-label="WhatsApp">{% render 'icon', name: 'whatsapp' %}</a></li>
          {%- endif -%}
        </ul>
      {%- endif -%}
      <p class="site-footer__copy">© {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: 64px 0 32px;
  }
  .site-footer__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 40px 32px;
    padding-bottom: 40px;
  }
  .site-footer__heading {
    margin: 0 0 16px;
    font-family: var(--serif);
    font-size: 1.15rem;
    font-weight: var(--heading-weight, 400);
    line-height: 1.3;
    color: inherit;
  }
  .site-footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .site-footer__text {
    font-size: .95rem;
  }
  .site-footer__text p { margin: 0 0 8px; }
  .site-footer__text p:last-child { margin-bottom: 0; }
  .site-footer__form {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }
  .site-footer__form input[type="email"] {
    flex: 1 1 180px;
    min-width: 0;
    padding: .75em 1.1em;
    border: 1px solid currentColor;
    border-radius: 999px;
    background: transparent;
    color: inherit;
    font: inherit;
  }
  .site-footer__form input[type="email"]::placeholder {
    color: inherit;
    opacity: .7;
  }
  .site-footer__form .btn {
    border: 0;
    font: inherit;
    cursor: pointer;
  }
  .site-footer__message {
    flex-basis: 100%;
    margin: 0;
    font-size: .9rem;
  }
  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 24px;
    border-top: 1px solid color-mix(in srgb, currentColor 20%, transparent);
  }
  .site-footer__social {
    display: flex;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-footer__social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid currentColor;
    border-radius: 999px;
    font-size: 18px;
    text-decoration: none;
  }
  .site-footer__copy {
    margin: 0;
    font-size: .9rem;
    opacity: .8;
  }
</style>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "cream", "label": "Cream" },
        { "value": "forest", "label": "Dark green" },
        { "value": "burgundy", "label": "Burgundy" }
      ],
      "default": "forest"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Link list",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Newsletter heading" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "menu", "settings": { "heading": "Shop", "menu": "main-menu" } },
        { "type": "menu", "settings": { "heading": "Info", "menu": "footer" } },
        { "type": "text", "settings": { "heading": "Contact", "text": "<p>Beirut, Lebanon</p><p>Cash on delivery available</p>" } },
        { "type": "newsletter", "settings": { "heading": "Newsletter heading", "text": "Short newsletter description goes here." } }
      ]
    }
  ]
}
{% endschema %}
