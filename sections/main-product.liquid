{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign image_count = 0
  for media in product.media
    if media.media_type == 'image'
      assign image_count = image_count | plus: 1
    endif
  endfor
-%}
<section class="section pdp {% render 'section-classes', settings: section.settings %}" data-product-section data-money-format="{{ shop.money_format | escape }}">
  <div class="container">
    {%- if product -%}
    <div class="pdp__layout">

      {%- comment -%} Gallery: one scroll-snap track. Swipe on phones, thumbnails on desktop. {%- endcomment -%}
      <div class="pdp-gallery{% if image_count > 1 %} pdp-gallery--multi{% endif %}" data-gallery>
        {%- if image_count > 0 -%}
          <ul class="pdp-gallery__track" data-gallery-track role="list" tabindex="0" aria-label="{{ product.title | escape }} images">
            {%- assign n = 0 -%}
            {%- for media in product.media -%}
              {%- if media.media_type == 'image' -%}
                {%- liquid
                  assign media_alt = media.alt | default: product.title
                  if n == 0
                    assign media_loading = 'eager'
                  else
                    assign media_loading = 'lazy'
                  endif
                -%}
                <li class="pdp-gallery__slide" data-gallery-slide data-index="{{ n }}" data-media-id="{{ media.id }}">
                  <div class="media-frame pdp-gallery__frame">
                    {{ media | image_url: width: 1400 | image_tag: alt: media_alt, loading: media_loading, sizes: '(min-width: 990px) 56vw, 100vw', widths: '600, 900, 1200, 1400' }}
                  </div>
                </li>
                {%- assign n = n | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
          </ul>

          {%- if image_count > 1 -%}
            <div class="pdp-gallery__progress" aria-hidden="true">
              <span class="pdp-gallery__count"><span data-gallery-current>1</span> / {{ image_count }}</span>
              <span class="pdp-gallery__bars">
                {%- for i in (1..image_count) -%}
                  <span class="pdp-gallery__bar{% if forloop.first %} is-active{% endif %}" data-gallery-dot></span>
                {%- endfor -%}
              </span>
            </div>

            <div class="pdp-gallery__thumbs" role="group" aria-label="Choose an image">
              {%- assign n = 0 -%}
              {%- for media in product.media -%}
                {%- if media.media_type == 'image' -%}
                  <button type="button" class="pdp-gallery__thumb" data-gallery-thumb data-index="{{ n }}" aria-label="Show image {{ n | plus: 1 }} of {{ image_count }}" aria-pressed="{% if n == 0 %}true{% else %}false{% endif %}">
                    <span class="media-frame">
                      {{ media | image_url: width: 240 | image_tag: alt: '', loading: 'lazy', widths: '120, 240', sizes: '96px' }}
                    </span>
                  </button>
                  {%- assign n = n | plus: 1 -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- else -%}
          <div class="media-frame pdp-gallery__frame">
            <div class="img-blank" data-label="Product image"></div>
          </div>
        {%- endif -%}
      </div>

      <div class="pdp-info sticky-col">
        {%- if section.settings.show_vendor -%}
          {%- if product.vendor != blank or product.type != blank -%}
            <p class="eyebrow eyebrow--rule pdp-info__eyebrow">
              {{- product.vendor -}}
              {%- if product.vendor != blank and product.type != blank %} <span aria-hidden="true">&middot;</span> {% endif -%}
              {{- product.type -}}
            </p>
          {%- endif -%}
        {%- endif -%}

        {% form 'product', product, class: 'product-form pdp-form' %}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

          {%- for block in section.blocks -%}
            <div class="pdp-block pdp-block--{{ block.type }}" {{ block.shopify_attributes }}>
              {%- case block.type -%}

                {%- when 'title' -%}
                  <h1 class="pdp-title h2">{{ product.title }}</h1>

                {%- when 'price' -%}
                  <div class="pdp-price" data-price>
                    {% render 'price', variant: current_variant %}
                  </div>
                  {%- if block.settings.note != blank -%}
                    <p class="pdp-price__note">{{ block.settings.note }}</p>
                  {%- endif -%}

                {%- when 'variant_picker' -%}
                  {%- unless product.has_only_default_variant -%}
                    {%- for option in product.options_with_values -%}
                      {%- assign option_index = forloop.index0 -%}
                      <fieldset class="pdp-option" data-option-group data-option-index="{{ option_index }}">
                        <legend class="pdp-label">
                          {{ option.name }}<span class="pdp-label__value" data-option-value>{{ option.selected_value }}</span>
                        </legend>
                        <div class="pill-group">
                          {%- for value in option.values -%}
                            {%- liquid
                              assign value_available = false
                              for variant in product.variants
                                if variant.options[option_index] == value and variant.available
                                  assign value_available = true
                                endif
                              endfor
                            -%}
                            <input class="pill-input" type="radio"
                              id="Option-{{ section.id }}-{{ option_index }}-{{ forloop.index0 }}"
                              name="option-{{ section.id }}-{{ option_index }}"
                              value="{{ value | escape }}"
                              data-option-radio data-option-index="{{ option_index }}"
                              {% if value == option.selected_value %}checked{% endif %}>
                            <label class="pill{% unless value_available %} is-unavailable{% endunless %}" for="Option-{{ section.id }}-{{ option_index }}-{{ forloop.index0 }}">
                              {{- value -}}
                              <span class="visually-hidden" data-unavailable-text{% if value_available %} hidden{% endif %}>, sold out</span>
                            </label>
                          {%- endfor -%}
                        </div>
                      </fieldset>
                    {%- endfor -%}
                  {%- endunless -%}

                {%- when 'quantity' -%}
                  <div class="pdp-qty">
                    <label class="pdp-label" for="Quantity-{{ section.id }}">Quantity</label>
                    <div class="qty" data-qty>
                      <button type="button" class="qty__btn" data-qty-dec aria-label="Decrease quantity">{% render 'icon', name: 'minus' %}</button>
                      <input class="qty__input" type="number" id="Quantity-{{ section.id }}" name="quantity" value="1" min="1" inputmode="numeric" data-quantity-input>
                      <button type="button" class="qty__btn" data-qty-inc aria-label="Increase quantity">{% render 'icon', name: 'plus' %}</button>
                    </div>
                  </div>

                {%- when 'buy_buttons' -%}
                  <button type="submit" class="btn btn--block pdp-add" data-add-to-cart {% unless current_variant.available %}disabled{% endunless %}>
                    <span data-add-label>{% if current_variant.available %}Add to cart{% else %}Sold out{% endif %}</span>
                  </button>

                {%- when 'reassurance' -%}
                  <ul class="pdp-assure" role="list">
                    {%- if block.settings.text_1 != blank -%}
                      <li class="pdp-assure__item">{% render 'icon', name: block.settings.icon_1 %}<span>{{ block.settings.text_1 }}</span></li>
                    {%- endif -%}
                    {%- if block.settings.text_2 != blank -%}
                      <li class="pdp-assure__item">{% render 'icon', name: block.settings.icon_2 %}<span>{{ block.settings.text_2 }}</span></li>
                    {%- endif -%}
                    {%- if block.settings.text_3 != blank -%}
                      <li class="pdp-assure__item">{% render 'icon', name: block.settings.icon_3 %}<span>{{ block.settings.text_3 }}</span></li>
                    {%- endif -%}
                  </ul>

                {%- when 'description' -%}
                  {%- if product.description != blank -%}
                    <div class="pdp-description rte">{{ product.description }}</div>
                  {%- endif -%}

                {%- when 'collapsible' -%}
                  <details class="accordion pdp-accordion"{% if block.settings.open %} open{% endif %}>
                    <summary class="accordion__summary">{{ block.settings.heading }}<span class="accordion__icon" aria-hidden="true"></span></summary>
                    <div class="accordion__body rte">{{ block.settings.content }}</div>
                  </details>

                {%- when 'text' -%}
                  <div class="pdp-text rte">{{ block.settings.text }}</div>

              {%- endcase -%}
            </div>
          {%- endfor -%}
        {% endform %}
      </div>

    </div>

    <script type="application/json" data-product-json>{{ product | json }}</script>
    {%- endif -%}
  </div>
</section>

<style>
  .pdp { padding-top: clamp(24px, 4vw, 56px); }
  .pdp__layout { display: grid; grid-template-columns: minmax(0, 1fr); gap: 36px; align-items: start; }
  @media (min-width: 990px) {
    .pdp__layout { grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: clamp(48px, 5vw, 88px); }
  }

  /* Gallery */
  .pdp-gallery { position: relative; min-width: 0; }
  .pdp-gallery__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    list-style: none;
    border-radius: var(--radius);
  }
  .pdp-gallery__track::-webkit-scrollbar { display: none; }
  .pdp-gallery__track:focus-visible { outline-offset: 4px; }
  .pdp-gallery__slide { scroll-snap-align: start; scroll-snap-stop: always; }
  .pdp-gallery__frame { border-radius: var(--radius); }

  .pdp-gallery__progress { display: flex; align-items: center; gap: 16px; margin-top: 16px; }
  .pdp-gallery__count { color: var(--fg-muted); font-size: var(--fs-small); font-variant-numeric: tabular-nums; letter-spacing: .08em; }
  .pdp-gallery__bars { display: flex; flex: 1; gap: 6px; }
  .pdp-gallery__bar { flex: 1; height: 1px; background: var(--rule); transition: background-color var(--dur) var(--ease); }
  .pdp-gallery__bar.is-active { height: 2px; background: var(--fg); }

  .pdp-gallery__thumbs { display: none; }
  @media (max-width: 989px) {
    .pdp { padding-top: 0; }
    .pdp-gallery { margin-inline: calc(var(--gutter) * -1); }
    .pdp-gallery__track { border-radius: 0; }
    .pdp-gallery__frame { border-radius: 0; }
    .pdp-gallery__progress { padding-inline: var(--gutter); }
  }
  @media (min-width: 990px) {
    .pdp-gallery { position: sticky; top: 120px; }
    .pdp-gallery__progress { display: none; }
    .pdp-gallery--multi { display: grid; grid-template-columns: 84px minmax(0, 1fr); gap: 20px; align-items: start; }
    .pdp-gallery--multi .pdp-gallery__track { grid-column: 2; grid-row: 1; }
    .pdp-gallery__thumbs {
      grid-column: 1;
      grid-row: 1;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .pdp-gallery__thumb {
      display: block;
      width: 100%;
      padding: 0;
      border: 0;
      border-radius: var(--radius);
      background: none;
      cursor: pointer;
      opacity: .62;
      transition: opacity var(--dur) var(--ease);
    }
    .pdp-gallery__thumb .media-frame { display: block; height: auto; outline: 1px solid transparent; outline-offset: 3px; transition: outline-color var(--dur) var(--ease); }
    .pdp-gallery__thumb img { height: 100%; }
    .pdp-gallery__thumb:hover { opacity: 1; }
    .pdp-gallery__thumb[aria-pressed="true"] { opacity: 1; }
    .pdp-gallery__thumb[aria-pressed="true"] .media-frame { outline-color: var(--fg); }
    .pdp-gallery__thumb:focus-visible { outline-offset: 6px; }
  }

  /* Info column */
  .pdp-info { min-width: 0; max-width: 540px; }
  .pdp-info__eyebrow { margin-bottom: 20px; }
  .pdp-form { margin: 0; }
  .pdp-block { min-width: 0; }
  .pdp-block + .pdp-block { margin-top: 28px; }
  .pdp-title { margin: 0; }
  .pdp-block--title + .pdp-block--price { margin-top: 16px; }
  .pdp-price .price { gap: 6px 14px; font-size: 1.3rem; }
  .pdp-price .price__current { font-weight: 400; }
  .pdp-price .price__compare { font-size: 1.05rem; }
  .pdp-price__note { margin: 6px 0 0; color: var(--fg-muted); font-size: var(--fs-small); }
  .pdp-block--price + .pdp-block { margin-top: 32px; padding-top: 32px; border-top: 1px solid var(--rule); }

  .pdp-option { min-width: 0; margin: 0; padding: 0; border: 0; }
  .pdp-option + .pdp-option { margin-top: 24px; }
  .pdp-label {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0 0 12px;
    padding: 0;
    color: var(--fg);
    font: 500 var(--fs-eyebrow)/1.3 var(--sans);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }
  .pdp-label__value { color: var(--fg-muted); font-weight: 400; letter-spacing: .06em; text-transform: none; font-size: .9rem; }
  .pdp-label__value::before { content: "\2014"; margin-right: 10px; color: var(--rule); }

  .pdp-block--quantity + .pdp-block--buy_buttons { margin-top: 20px; }
  .pdp-add { min-height: 56px; }
  .pdp-add:disabled, .pdp-add:disabled:hover { --_bg: transparent; --_fg: var(--fg-muted); --_border: var(--field-border); opacity: 1; }

  .pdp-assure {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    border-block: 1px solid var(--rule);
  }
  .pdp-block--buy_buttons + .pdp-block--reassurance { margin-top: 20px; }
  .pdp-assure__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 18px 10px;
    color: var(--fg);
    font-size: .8rem;
    line-height: 1.35;
    letter-spacing: .02em;
    text-align: center;
  }
  .pdp-assure__item + .pdp-assure__item { border-left: 1px solid var(--rule); }
  .pdp-assure__item .icon { font-size: 22px; color: var(--accent); stroke-width: 1.35; }

  .pdp-description { color: var(--fg-muted); line-height: 1.75; }
  .pdp-block--collapsible + .pdp-block--collapsible { margin-top: 0; }
  .pdp-block--collapsible:not(.pdp-block--collapsible + .pdp-block--collapsible) .accordion { border-top: 1px solid var(--rule); }
  .pdp-accordion .accordion__summary { padding: 20px 0; }
  .pdp-accordion .accordion__body { font-size: .95rem; }
</style>

{% schema %}
{
  "name": "Product",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor and product type",
      "default": true
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "cream", "label": "Cream" },
        { "value": "forest", "label": "Dark green" },
        { "value": "burgundy", "label": "Burgundy" }
      ],
      "default": "light"
    },
    {
      "type": "select",
      "id": "padding",
      "label": "Spacing",
      "options": [
        { "value": "s", "label": "Small" },
        { "value": "m", "label": "Medium" },
        { "value": "l", "label": "Large" }
      ],
      "default": "m"
    }
  ],
  "blocks": [
    { "type": "title", "name": "Title", "limit": 1, "settings": [] },
    {
      "type": "price",
      "name": "Price",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "note", "label": "Note under the price", "default": "Tax included. Delivery calculated at checkout." }
      ]
    },
    { "type": "variant_picker", "name": "Variant picker", "limit": 1, "settings": [] },
    { "type": "quantity", "name": "Quantity", "limit": 1, "settings": [] },
    { "type": "buy_buttons", "name": "Buy buttons", "limit": 1, "settings": [] },
    {
      "type": "reassurance",
      "name": "Reassurance",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "icon_1",
          "label": "Icon 1",
          "options": [
            { "value": "cash", "label": "Cash" },
            { "value": "truck", "label": "Truck" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "honeycomb", "label": "Honeycomb" },
            { "value": "jar", "label": "Jar" },
            { "value": "hand", "label": "Hand" },
            { "value": "sprout", "label": "Sprout" },
            { "value": "cup", "label": "Cup" }
          ],
          "default": "cash"
        },
        { "type": "text", "id": "text_1", "label": "Text 1", "default": "Cash on delivery" },
        {
          "type": "select",
          "id": "icon_2",
          "label": "Icon 2",
          "options": [
            { "value": "cash", "label": "Cash" },
            { "value": "truck", "label": "Truck" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "honeycomb", "label": "Honeycomb" },
            { "value": "jar", "label": "Jar" },
            { "value": "hand", "label": "Hand" },
            { "value": "sprout", "label": "Sprout" },
            { "value": "cup", "label": "Cup" }
          ],
          "default": "truck"
        },
        { "type": "text", "id": "text_2", "label": "Text 2", "default": "Delivery across Lebanon" },
        {
          "type": "select",
          "id": "icon_3",
          "label": "Icon 3",
          "options": [
            { "value": "cash", "label": "Cash" },
            { "value": "truck", "label": "Truck" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "honeycomb", "label": "Honeycomb" },
            { "value": "jar", "label": "Jar" },
            { "value": "hand", "label": "Hand" },
            { "value": "sprout", "label": "Sprout" },
            { "value": "cup", "label": "Cup" }
          ],
          "default": "leaf"
        },
        { "type": "text", "id": "text_3", "label": "Text 3", "default": "Short benefit" }
      ]
    },
    { "type": "description", "name": "Description", "limit": 1, "settings": [] },
    {
      "type": "collapsible",
      "name": "Collapsible tab",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Section heading" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Placeholder text for this tab.</p>" },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Body text goes here.</p>" }
      ]
    }
  ]
}
{% endschema %}
