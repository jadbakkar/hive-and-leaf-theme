{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign has_images = false
  for media in product.media
    if media.media_type == 'image'
      assign has_images = true
    endif
  endfor
-%}
<section class="section product-section {% render 'section-classes', settings: section.settings %}" data-product-section data-money-format="{{ shop.money_format | escape }}">
<div class="container">
  {% if product %}
  <div class="product-layout">

    <div class="product-gallery" data-gallery>
      <div class="card-media product-gallery__main">
        {% if has_images %}
          {% assign slide_shown = false %}
          {% for media in product.media %}
            {% if media.media_type == 'image' %}
              <div class="product-gallery__slide" data-gallery-slide data-index="{{ forloop.index0 }}" data-media-id="{{ media.id }}" {% if slide_shown %}hidden{% endif %}>
                {{ media | image_url: width: 1000 | image_tag: alt: product.title, loading: 'lazy' }}
              </div>
              {% assign slide_shown = true %}
            {% endif %}
          {% endfor %}
        {% else %}
          <div class="img-blank img-blank--portrait"></div>
        {% endif %}
      </div>

      {% if has_images and product.media.size > 1 %}
        <div class="product-gallery__thumbs">
          {% for media in product.media %}
            {% if media.media_type == 'image' %}
              <button type="button" class="product-gallery__thumb" data-gallery-thumb data-index="{{ forloop.index0 }}" aria-label="Show image {{ forloop.index }}" aria-pressed="false">
                {{ media | image_url: width: 160 | image_tag: alt: '', loading: 'lazy' }}
              </button>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="product-info">
      {% if section.settings.show_vendor and product.vendor != blank %}
        <p class="product-vendor">{{ product.vendor }}</p>
      {% endif %}

      {% form 'product', product, class: 'product-form' %}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

        {% for block in section.blocks %}
          <div class="product-block" {{ block.shopify_attributes }}>
            {%- case block.type -%}

              {%- when 'title' -%}
                <h1 class="product-title">{{ product.title }}</h1>

              {%- when 'price' -%}
                <div data-price>
                  {% render 'price', variant: current_variant %}
                </div>

              {%- when 'variant_picker' -%}
                {% for option in product.options_with_values %}
                  {% assign option_index = forloop.index0 %}
                  <div class="product-option">
                    <label class="product-label" for="option-{{ section.id }}-{{ option_index }}">{{ option.name }}</label>
                    <select class="product-option__select" id="option-{{ section.id }}-{{ option_index }}" data-option-select data-option-index="{{ option_index }}">
                      {% for value in option.values %}
                        <option value="{{ value | escape }}"{% if value == option.selected_value %} selected{% endif %}>{{ value }}</option>
                      {% endfor %}
                    </select>
                  </div>
                {% endfor %}

              {%- when 'quantity' -%}
                <div class="product-quantity">
                  <span class="product-label">Quantity</span>
                  <div class="quantity">
                    <button type="button" class="quantity__btn" data-qty-dec aria-label="Decrease quantity">&minus;</button>
                    <input type="number" name="quantity" value="1" min="1" class="quantity__input" data-quantity-input aria-label="Quantity">
                    <button type="button" class="quantity__btn" data-qty-inc aria-label="Increase quantity">+</button>
                  </div>
                </div>

              {%- when 'buy_buttons' -%}
                <button type="submit" class="btn buy-button" data-add-to-cart {% unless current_variant.available %}disabled{% endunless %}>
                  <span data-add-label>{% if current_variant.available %}Add to cart{% else %}Sold out{% endif %}</span>
                </button>

              {%- when 'description' -%}
                {% if product.description != blank %}
                  <div class="product-richtext">{{ product.description }}</div>
                {% endif %}

              {%- when 'collapsible' -%}
                <details class="product-tab">
                  <summary>{{ block.settings.heading }}</summary>
                  <div class="product-tab__body product-richtext">{{ block.settings.content }}</div>
                </details>

              {%- when 'text' -%}
                <div class="product-richtext">{{ block.settings.text }}</div>

            {%- endcase -%}
          </div>
        {% endfor %}
      {% endform %}
    </div>

  </div>

  <script type="application/json" data-product-json>{{ product | json }}</script>
  {% endif %}
</div>
</section>

<style>
  .product-layout { display: grid; grid-template-columns: minmax(0, 1fr); gap: 32px; align-items: start; }
  @media (min-width: 768px) {
    .product-layout { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 64px; }
  }

  /* Gallery */
  .product-gallery__main { position: relative; }
  .product-gallery__slide { position: absolute; inset: 0; }
  .product-gallery__slide[hidden] { display: none; }
  .product-gallery__thumbs { display: flex; gap: 8px; margin-top: 12px; overflow-x: auto; }
  .product-gallery__thumb {
    flex: 0 0 72px; padding: 0; border: 2px solid transparent; border-radius: 8px;
    overflow: hidden; background: var(--cream); cursor: pointer;
  }
  .product-gallery__thumb[aria-pressed="true"] { border-color: var(--forest); }
  .product-gallery__thumb img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }

  /* Info column */
  .product-info { display: flex; flex-direction: column; gap: 16px; min-width: 0; }
  .product-vendor { margin: 0; font-size: .78rem; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); }
  .product-form { display: flex; flex-direction: column; gap: 20px; margin: 0; }
  .product-block { min-width: 0; }
  .product-title { font-size: clamp(2rem, 3.4vw, 2.75rem); margin: 0; }
  .product-label { display: block; font-size: .9rem; font-weight: 500; margin: 0 0 8px; }
  .product-option__select {
    width: 100%; padding: .8em 2.4em .8em 1em; border: 1px solid var(--line); border-radius: 8px;
    background: #fff; color: var(--ink); font: inherit;
  }

  .quantity {
    display: inline-flex; align-items: center; border: 1px solid var(--line);
    border-radius: 999px; background: #fff; color: var(--ink);
  }
  .quantity__btn { width: 44px; height: 44px; border: 0; background: transparent; color: inherit; font: inherit; font-size: 1.2rem; cursor: pointer; }
  .quantity__input {
    width: 56px; border: 0; background: transparent; color: inherit; font: inherit; text-align: center;
    -moz-appearance: textfield; appearance: textfield;
  }
  .quantity__input::-webkit-inner-spin-button,
  .quantity__input::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }

  .product-section .buy-button { width: 100%; padding: 1em 1.6em; font: inherit; font-weight: 500; }
  .product-section .buy-button:disabled,
  .product-section .buy-button:disabled:hover {
    background: var(--line); color: var(--muted); cursor: not-allowed;
  }

  /* Description and collapsible tabs */
  .product-richtext { font-size: .95rem; }
  .product-richtext p { margin: 0 0 .75em; }
  .product-richtext p:last-child { margin-bottom: 0; }
  .product-tab { border-top: 1px solid var(--line); }
  .product-tab summary {
    display: flex; justify-content: space-between; align-items: center; gap: 16px;
    padding: 16px 0; cursor: pointer; list-style: none;
    font-family: var(--serif); font-size: 1.1rem; color: inherit;
  }
  .product-tab summary::-webkit-details-marker { display: none; }
  .product-tab summary::after { content: "+"; font-family: var(--sans); font-size: 1.25rem; line-height: 1; }
  .product-tab[open] summary::after { content: "\2212"; }
  .product-tab__body { padding: 0 0 16px; }
</style>

{% schema %}
{
  "name": "Product",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": true
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "cream", "label": "Cream" },
        { "value": "forest", "label": "Dark green" },
        { "value": "burgundy", "label": "Burgundy" }
      ],
      "default": "light"
    }
  ],
  "blocks": [
    { "type": "title", "name": "Title", "settings": [] },
    { "type": "price", "name": "Price", "settings": [] },
    { "type": "variant_picker", "name": "Variant picker", "settings": [] },
    { "type": "quantity", "name": "Quantity", "settings": [] },
    { "type": "buy_buttons", "name": "Buy buttons", "settings": [] },
    { "type": "description", "name": "Description", "settings": [] },
    {
      "type": "collapsible",
      "name": "Collapsible tab",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Section heading" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Placeholder text for this tab.</p>" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Body text goes here.</p>" }
      ]
    }
  ]
}
{% endschema %}
