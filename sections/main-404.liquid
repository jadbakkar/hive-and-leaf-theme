<section class="section scheme-{{ section.settings.color_scheme | default: 'light' }}">
<div class="container">
  <h1>Page not found</h1>
  <p>The page you are looking for does not exist.</p>
  <p><a class="btn" href="{{ routes.root_url }}">Back to home</a></p>
</div>
</section>

{% schema %}
{
  "name": "404",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "cream",
          "label": "Cream"
        },
        {
          "value": "forest",
          "label": "Dark green"
        },
        {
          "value": "burgundy",
          "label": "Burgundy"
        }
      ],
      "default": "light"
    }
  ]
}
{% endschema %}
