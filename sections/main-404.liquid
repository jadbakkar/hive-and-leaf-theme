<section class="section not-found {% render 'section-classes', settings: section.settings %}">
  <div class="container">
    <div class="empty-state not-found__inner">
      <p class="not-found__code" aria-hidden="true">4<span class="not-found__mark">{% render 'icon', name: 'honeycomb' %}</span>4</p>
      <p class="eyebrow eyebrow--flank">Error 404</p>
      <h1 class="empty-state__title h2">{{ section.settings.heading }}</h1>
      <p class="lede">{{ section.settings.text }}</p>

      <form class="inline-form not-found__search" action="{{ routes.search_url }}" method="get" role="search">
        <label class="visually-hidden" for="NotFoundSearch-{{ section.id }}">Search the store</label>
        <input class="input" type="search" id="NotFoundSearch-{{ section.id }}" name="q" placeholder="Search honey, tea, gifts" autocomplete="off">
        <button class="btn" type="submit">Search</button>
      </form>

      <div class="btn-row">
        <a class="link-arrow link-arrow--back" href="{{ routes.root_url }}">Back to home</a>
        <a class="link-arrow" href="{{ routes.all_products_collection_url }}">Shop all</a>
      </div>
    </div>
  </div>
</section>

<style>
  .not-found__inner { padding-block: clamp(16px, 4vw, 48px); }
  .not-found__code {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: .08em;
    margin: 0 0 32px;
    color: var(--heading);
    font: var(--heading-weight, 400) clamp(6rem, 4rem + 9vw, 11rem)/1 var(--serif);
    letter-spacing: -.02em;
  }
  .not-found__mark { display: inline-grid; place-items: center; width: .62em; height: .62em; margin-inline: .04em; color: var(--accent); font-size: 1em; transform: translateY(.1em); }
  .not-found__mark .icon { width: 100%; height: 100%; stroke-width: .7; }
  .not-found__search { margin: 36px auto 0; }
  .not-found__inner .btn-row { gap: 16px 40px; }
</style>

{% schema %}
{
  "name": "404",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Page not found"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "The page you were looking for has moved or no longer exists. Try a search, or head back to the shop."
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "cream",
          "label": "Cream"
        },
        {
          "value": "forest",
          "label": "Dark green"
        },
        {
          "value": "burgundy",
          "label": "Burgundy"
        }
      ],
      "default": "light"
    }
  ]
}
{% endschema %}
