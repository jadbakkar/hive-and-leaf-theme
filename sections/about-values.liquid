<style>
  .about-values__title { text-align: center; font-size: clamp(2rem, 4vw, 2.75rem); color: var(--forest); margin-bottom: 40px; }
  .about-value { text-align: center; }
  .about-value h3 { font-size: 1.5rem; color: var(--forest); margin-top: 20px; }
  .about-value p { color: var(--muted); margin: 0; }
  .about-frame { position: relative; width: 100%; border-radius: 12px; overflow: hidden; background: var(--cream); }
  .about-frame--square { aspect-ratio: 1 / 1; }
</style>

<section class="section about-values">
  <div class="container">
    <h2 class="about-values__title">{{ section.settings.heading }}</h2>

    <div class="grid">
      {% for block in section.blocks %}
        <div class="about-value" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <div class="about-frame about-frame--square">
              {{ block.settings.image | image_url: width: 1200 | image_tag: class: 'img-fill', loading: 'lazy' }}
            </div>
          {% else %}
            <div class="img-blank img-blank--square"></div>
          {% endif %}
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About values",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What we believe" }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Value" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "A short line about this value." }
      ]
    }
  ],
  "presets": [
    {
      "name": "About values",
      "blocks": [
        { "type": "value", "settings": { "title": "Nourish", "text": "Simple, whole ingredients. Tea leaves and raw honey, nothing added." } },
        { "type": "value", "settings": { "title": "Move", "text": "Small daily habits add up. A cup between tasks is a gentle reset." } },
        { "type": "value", "settings": { "title": "Rest", "text": "Rest is part of the routine. Slow down and let the day settle." } }
      ]
    }
  ]
}
{% endschema %}
