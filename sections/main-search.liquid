{%- assign terms = search.terms | escape -%}
<section class="section search {% render 'section-classes', settings: section.settings %}">
  <div class="container">
    <header class="search__header">
      <p class="eyebrow eyebrow--flank">Search</p>
      <h1 class="search__title">
        {%- if search.performed and search.terms != blank -%}
          Results for <em>&ldquo;{{ terms }}&rdquo;</em>
        {%- else -%}
          What are you looking for?
        {%- endif -%}
      </h1>

      <form class="search__form" action="{{ routes.search_url }}" method="get" role="search">
        <label class="visually-hidden" for="SearchInput-{{ section.id }}">Search the store</label>
        {%- if section.settings.products_only -%}
          <input type="hidden" name="type" value="product">
        {%- endif -%}
        <span class="search__icon" aria-hidden="true">{% render 'icon', name: 'search' %}</span>
        <input class="search__input" type="search" name="q" id="SearchInput-{{ section.id }}" value="{{ terms }}" placeholder="Body oil, honey blend, gift set" autocomplete="off">
        <button type="submit" class="btn search__submit">Search</button>
      </form>

      {%- if search.performed -%}
        <p class="meta search__count" role="status"><span>{{ search.results_count }} {% if search.results_count == 1 %}result{% else %}results{% endif %}</span></p>
      {%- endif -%}
    </header>

    {%- if search.performed -%}
      {%- paginate search.results by 12 -%}
        {%- if search.results_count > 0 -%}
          {%- liquid
            assign product_count = 0
            assign other_count = 0
            for item in search.results
              if item.object_type == 'product'
                assign product_count = product_count | plus: 1
              else
                assign other_count = other_count | plus: 1
              endif
            endfor
          -%}

          {%- if product_count > 0 -%}
            <div class="search__group">
              <h2 class="search__group-title">Products <span class="search__group-count">{{ product_count }}</span></h2>
              <ul class="search__grid" role="list">
                {%- for item in search.results -%}
                  {%- if item.object_type == 'product' -%}
                    <li>{% render 'product-card', product: item %}</li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          {%- if other_count > 0 -%}
            <div class="search__group">
              <h2 class="search__group-title">Journal &amp; pages <span class="search__group-count">{{ other_count }}</span></h2>
              <ul class="search__list" role="list">
                {%- for item in search.results -%}
                  {%- unless item.object_type == 'product' -%}
                    <li class="search-result">
                      <p class="meta search-result__type">
                        <span>{% if item.object_type == 'article' %}Journal{% else %}Page{% endif %}</span>
                        {%- if item.object_type == 'article' -%}<span>{{ item.published_at | date: '%B %-d, %Y' }}</span>{%- endif -%}
                      </p>
                      <h3 class="search-result__title"><a href="{{ item.url }}">{{ item.title }}</a></h3>
                      {%- if item.object_type == 'article' -%}
                        <p class="search-result__excerpt">{{ item.excerpt_or_content | strip_html | truncatewords: 30 }}</p>
                      {%- else -%}
                        <p class="search-result__excerpt">{{ item.content | strip_html | truncatewords: 30 }}</p>
                      {%- endif -%}
                      <span class="link-arrow search-result__arrow" aria-hidden="true"></span>
                    </li>
                  {%- endunless -%}
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          {% render 'pagination', paginate: paginate %}
        {%- else -%}
          <div class="empty-state">
            <span class="icon-badge">{% render 'icon', name: 'search' %}</span>
            <h2 class="empty-state__title h3">Nothing found for &ldquo;{{ terms }}&rdquo;</h2>
            <p class="lede">Check the spelling, try a shorter word, or browse the full range.</p>
            <div class="btn-row"><a class="btn" href="{{ routes.all_products_collection_url }}">Shop all</a></div>
          </div>
        {%- endif -%}
      {%- endpaginate -%}
    {%- else -%}
      <div class="search__suggest">
        <p class="eyebrow">Popular</p>
        <ul class="search__suggest-list" role="list">
          {%- for collection in collections limit: 6 -%}
            <li><a class="chip" href="{{ collection.url }}">{{ collection.title }}</a></li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  .search { padding-top: clamp(40px, 5vw, 72px); }
  .search__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: clamp(40px, 5vw, 72px);
    padding-bottom: clamp(32px, 4vw, 56px);
    border-bottom: 1px solid var(--rule);
    text-align: center;
  }
  .search__header .eyebrow { justify-content: center; }
  .search__title { margin: 0 0 clamp(28px, 4vw, 44px); font-size: var(--fs-h2); }
  .search__title em { color: var(--accent); }

  .search__form { position: relative; display: flex; gap: 8px; width: 100%; max-width: 640px; }
  .search__icon { position: absolute; top: 50%; left: 18px; color: var(--fg-muted); font-size: 20px; transform: translateY(-50%); pointer-events: none; }
  .search__input {
    flex: 1;
    min-width: 0;
    min-height: 56px;
    padding: 0 18px 0 50px;
    border: 1px solid var(--field-border);
    border-radius: var(--radius);
    background: transparent;
    color: inherit;
    font: 400 1.05rem/1.2 var(--sans);
    transition: border-color var(--dur) var(--ease);
  }
  .search__input::placeholder { color: var(--fg-muted); }
  .search__input:hover { border-color: var(--fg); }
  .search__input:focus-visible { border-color: var(--fg); outline: 2px solid var(--accent); outline-offset: 2px; }
  .search__input::-webkit-search-cancel-button { -webkit-appearance: none; }
  .search__submit { min-height: 56px; }
  @media (max-width: 479px) {
    .search__submit { padding-inline: 18px; }
  }
  .search__count { margin-top: 20px; }

  .search__group + .search__group { margin-top: clamp(56px, 7vw, 96px); }
  .search__group-title {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin: 0 0 32px;
    color: var(--fg);
    font: 500 var(--fs-eyebrow)/1.3 var(--sans);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }
  .search__group-count { color: var(--fg-muted); }
  .search__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px 16px; margin: 0; padding: 0; list-style: none; }
  @media (min-width: 990px) { .search__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 56px 24px; } }

  .search__list { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--rule); }
  .search-result {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 32px;
    padding: 28px 0;
    border-bottom: 1px solid var(--rule);
  }
  .search-result > :not(.search-result__arrow) { grid-column: 1; }
  .search-result__type { margin-bottom: 10px; }
  .search-result__title { margin: 0 0 8px; font-size: var(--fs-h3); }
  .search-result__title a { text-decoration: none; }
  .search-result__title a::after { content: ""; position: absolute; inset: 0; }
  .search-result__excerpt { margin: 0; color: var(--fg-muted); max-width: var(--measure); }
  .search-result__arrow { grid-column: 2; grid-row: 1 / span 3; align-self: center; }
  .search-result:hover .search-result__title a { color: var(--accent); }
  .search-result:hover .search-result__arrow::after { transform: translateX(4px); }

  .search__suggest { text-align: center; }
  .search__suggest .eyebrow { justify-content: center; }
  .search__suggest-list { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin: 0; padding: 0; list-style: none; }
</style>

{% schema %}
{
  "name": "Search",
  "settings": [
    {
      "type": "checkbox",
      "id": "products_only",
      "label": "Search products only",
      "default": false
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "cream",
          "label": "Cream"
        },
        {
          "value": "forest",
          "label": "Dark (primary)"
        },
        {
          "value": "burgundy",
          "label": "Accent"
        }
      ],
      "default": "light"
    }
  ]
}
{% endschema %}
