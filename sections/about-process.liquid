<style>
  .about-process__title { text-align: center; font-size: clamp(2rem, 4vw, 2.75rem); color: var(--forest); margin-bottom: 56px; }
  .about-step { display: grid; gap: 24px; align-items: center; margin-bottom: 56px; }
  .about-step:last-child { margin-bottom: 0; }
  .about-step__num { font-family: var(--serif); font-size: 3rem; line-height: 1; color: var(--burgundy); }
  .about-step__title { font-size: 1.75rem; color: var(--forest); margin-top: 8px; }
  .about-step__text { color: var(--muted); margin: 0; }
  .about-frame { position: relative; width: 100%; border-radius: 12px; overflow: hidden; background: var(--cream); aspect-ratio: 4 / 3; }
  @media (min-width: 768px) {
    .about-step { grid-template-columns: 1fr 1fr; gap: 48px; }
    .about-step--image-left .about-step__media { grid-column: 1; grid-row: 1; }
    .about-step--image-left .about-step__text { grid-column: 2; grid-row: 1; }
    .about-step--image-right .about-step__media { grid-column: 2; grid-row: 1; }
    .about-step--image-right .about-step__text { grid-column: 1; grid-row: 1; }
  }
</style>

<section class="section about-process">
  <div class="container">
    <h2 class="about-process__title">{{ section.settings.heading }}</h2>

    {% for block in section.blocks %}
      {% assign side = forloop.index | modulo: 2 %}
      {% if side == 1 %}
        {% assign step_class = 'about-step--image-left' %}
      {% else %}
        {% assign step_class = 'about-step--image-right' %}
      {% endif %}

      <div class="about-step {{ step_class }}" {{ block.shopify_attributes }}>
        <div class="about-step__media">
          {% if block.settings.image != blank %}
            <div class="about-frame">
              {{ block.settings.image | image_url: width: 1200 | image_tag: class: 'img-fill', loading: 'lazy' }}
            </div>
          {% else %}
            <div class="img-blank"></div>
          {% endif %}
        </div>

        <div class="about-step__text">
          <span class="about-step__num">{{ block.settings.number }}</span>
          <h3 class="about-step__title">{{ block.settings.title }}</h3>
          <p class="about-step__text-body">{{ block.settings.text }}</p>
        </div>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "About process",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Section heading" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "01" },
        { "type": "text", "id": "title", "label": "Title", "default": "Step" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "A short line about this step." },
        { "type": "image_picker", "id": "image", "label": "Image" }
      ]
    }
  ],
  "presets": [
    {
      "name": "About process",
      "blocks": [
        { "type": "step", "settings": { "number": "01", "title": "Title", "text": "Short description goes here." } },
        { "type": "step", "settings": { "number": "02", "title": "Title", "text": "Short description goes here." } },
        { "type": "step", "settings": { "number": "03", "title": "Title", "text": "Short description goes here." } },
        { "type": "step", "settings": { "number": "04", "title": "Title", "text": "Short description goes here." } }
      ]
    }
  ]
}
{% endschema %}
