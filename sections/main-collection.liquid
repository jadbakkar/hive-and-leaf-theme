{%- liquid
  assign active_count = 0
  for filter in collection.filters
    if filter.type == 'price_range'
      if filter.min_value.value != blank or filter.max_value.value != blank
        assign active_count = active_count | plus: 1
      endif
    else
      assign active_count = active_count | plus: filter.active_values.size
    endif
  endfor
  assign has_filters = false
  if section.settings.enable_filtering and collection.filters.size > 0
    assign has_filters = true
  endif
  assign filter_form_id = 'CollectionFilters-' | append: section.id
  assign sort_form_id = 'CollectionSort-' | append: section.id
  assign drawer_id = 'FilterDrawer-' | append: section.id
-%}
<section class="section collection {% render 'section-classes', settings: section.settings %}" style="--columns: {{ section.settings.columns }};">
  <div class="container">

    <header class="collection__header{% if collection.image %} collection__header--media{% endif %}">
      <div class="collection__intro">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow eyebrow--rule">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h1 class="collection__title">{{ collection.title }}</h1>
        {%- if section.settings.show_description and collection.description != blank -%}
          <div class="collection__description lede rte">{{ collection.description }}</div>
        {%- endif -%}
      </div>
      {%- if collection.image -%}
        <div class="collection__media media-frame media-frame--landscape">
          {{ collection.image | image_url: width: 1200 | image_tag: alt: collection.title, loading: 'eager', sizes: '(min-width: 990px) 40vw, 100vw', widths: '500, 800, 1200' }}
        </div>
      {%- endif -%}
    </header>

    {% paginate collection.products by section.settings.per_page %}
      <div class="collection__layout{% if has_filters %} collection__layout--filtered{% endif %}">

        {%- if has_filters -%}
          <div class="collection__overlay" data-filter-overlay="{{ drawer_id }}" aria-hidden="true"></div>
          <aside class="collection__filters" id="{{ drawer_id }}" data-filter-drawer aria-label="Filters" tabindex="-1">
            <form id="{{ filter_form_id }}" class="filters" action="{{ collection.url }}" method="get" data-collection-form>
              <div class="filters__head">
                <h2 class="filters__title">Filter</h2>
                <button type="button" class="filters__close" data-filter-close aria-label="Close filters">{% render 'icon', name: 'close' %}</button>
              </div>

              <div class="filters__body accordion-group">
                {%- for filter in collection.filters -%}
                  {%- liquid
                    assign group_active = filter.active_values.size
                    if filter.type == 'price_range'
                      assign group_active = 0
                      if filter.min_value.value != blank or filter.max_value.value != blank
                        assign group_active = 1
                      endif
                    endif
                  -%}
                  <details class="accordion accordion--small filters__group" open>
                    <summary class="accordion__summary">
                      <span>{{ filter.label }}{% if group_active > 0 %}<span class="filters__badge">{{ group_active }}</span>{% endif %}</span>
                      <span class="accordion__icon" aria-hidden="true"></span>
                    </summary>
                    <div class="accordion__body">
                      {%- case filter.type -%}
                        {%- when 'price_range' -%}
                          <div class="filters__price">
                            <div class="field">
                              <label for="{{ filter.min_value.param_name }}-{{ section.id }}">From</label>
                              <div class="filters__money">
                                <span aria-hidden="true">{{ cart.currency.symbol }}</span>
                                <input class="input" type="number" inputmode="decimal" id="{{ filter.min_value.param_name }}-{{ section.id }}" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | money_without_currency | remove: ',' }}" min="{{ filter.range_min | money_without_currency | remove: ',' }}" max="{{ filter.range_max | money_without_currency | remove: ',' }}" step="any" placeholder="{{ filter.range_min | money_without_currency | remove: ',' }}" data-auto-submit="desktop">
                              </div>
                            </div>
                            <div class="field">
                              <label for="{{ filter.max_value.param_name }}-{{ section.id }}">To</label>
                              <div class="filters__money">
                                <span aria-hidden="true">{{ cart.currency.symbol }}</span>
                                <input class="input" type="number" inputmode="decimal" id="{{ filter.max_value.param_name }}-{{ section.id }}" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | money_without_currency | remove: ',' }}" min="{{ filter.range_min | money_without_currency | remove: ',' }}" max="{{ filter.range_max | money_without_currency | remove: ',' }}" step="any" placeholder="{{ filter.range_max | money_without_currency | remove: ',' }}" data-auto-submit="desktop">
                              </div>
                            </div>
                          </div>
                        {%- else -%}
                          <ul class="filters__list" role="list">
                            {%- for value in filter.values -%}
                              <li>
                                <label class="check{% if value.count == 0 and value.active == false %} is-disabled{% endif %}">
                                  <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %} data-auto-submit="desktop">
                                  <span>{{ value.label }}</span>
                                  <span class="check__count">{{ value.count }}</span>
                                </label>
                              </li>
                            {%- endfor -%}
                          </ul>
                      {%- endcase -%}
                    </div>
                  </details>
                {%- endfor -%}
              </div>

              <div class="filters__foot">
                <a class="btn btn--outline" href="{{ collection.url }}{% if collection.sort_by != blank %}?sort_by={{ collection.sort_by }}{% endif %}">Clear all</a>
                <button type="submit" class="btn">Show results</button>
              </div>
            </form>
          </aside>
        {%- endif -%}

        <div class="collection__results">
          <div class="collection__toolbar">
            {%- if has_filters -%}
              <button type="button" class="collection__filter-toggle" data-filter-open aria-controls="{{ drawer_id }}" aria-expanded="false">
                <svg class="icon" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M4 7h10M18 7h2M4 17h4M12 17h8"/><circle cx="16" cy="7" r="2"/><circle cx="10" cy="17" r="2"/></svg>
                Filter{% if active_count > 0 %}<span class="filters__badge">{{ active_count }}</span>{% endif %}
              </button>
            {%- endif -%}
            <p class="collection__count" role="status">{{ collection.products_count }} {% if collection.products_count == 1 %}product{% else %}products{% endif %}</p>

            <div class="collection__sort">
              <label class="collection__sort-label" for="SortBy-{{ section.id }}">Sort by</label>
              <div class="select">
                <select id="SortBy-{{ section.id }}" name="sort_by" form="{% if has_filters %}{{ filter_form_id }}{% else %}{{ sort_form_id }}{% endif %}" data-auto-submit>
                  {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
                  {%- for option in collection.sort_options -%}
                    <option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
                  {%- endfor -%}
                </select>
              </div>
              {%- unless has_filters -%}
                <form id="{{ sort_form_id }}" action="{{ collection.url }}" method="get" data-collection-form></form>
              {%- endunless -%}
              <noscript><button type="submit" class="btn btn--small btn--outline" form="{% if has_filters %}{{ filter_form_id }}{% else %}{{ sort_form_id }}{% endif %}">Sort</button></noscript>
            </div>
          </div>

          {%- if active_count > 0 -%}
            <ul class="collection__chips" role="list" aria-label="Active filters">
              {%- for filter in collection.filters -%}
                {%- if filter.type == 'price_range' -%}
                  {%- if filter.min_value.value != blank or filter.max_value.value != blank -%}
                    <li>
                      <a class="chip" href="{{ filter.url_to_remove }}">
                        {{ filter.min_value.value | default: filter.range_min | money }} &ndash; {{ filter.max_value.value | default: filter.range_max | money }}
                        {% render 'icon', name: 'close' %}<span class="visually-hidden">Remove filter</span>
                      </a>
                    </li>
                  {%- endif -%}
                {%- else -%}
                  {%- for value in filter.active_values -%}
                    <li>
                      <a class="chip" href="{{ value.url_to_remove }}">
                        {{ value.label }}
                        {% render 'icon', name: 'close' %}<span class="visually-hidden">Remove filter: {{ filter.label }} {{ value.label }}</span>
                      </a>
                    </li>
                  {%- endfor -%}
                {%- endif -%}
              {%- endfor -%}
              <li><a class="btn btn--link collection__clear" href="{{ collection.url }}{% if collection.sort_by != blank %}?sort_by={{ collection.sort_by }}{% endif %}">Clear all</a></li>
            </ul>
          {%- endif -%}

          {%- if collection.products_count == 0 -%}
            <div class="empty-state">
              <span class="icon-badge">{% render 'icon', name: 'leaf' %}</span>
              {%- if active_count > 0 -%}
                <h2 class="empty-state__title h3">No products match these filters</h2>
                <p class="lede">Try removing a filter or two to see more of the range.</p>
                <div class="btn-row"><a class="btn btn--outline" href="{{ collection.url }}">Clear all filters</a></div>
              {%- else -%}
                <h2 class="empty-state__title h3">Nothing here yet</h2>
                <p class="lede">This collection is being restocked. Check back soon.</p>
                <div class="btn-row"><a class="btn" href="{{ routes.all_products_collection_url }}">Shop all</a></div>
              {%- endif -%}
            </div>
          {%- else -%}
            <ul class="collection__grid" role="list">
              {%- for product in collection.products -%}
                <li class="collection__item">{% render 'product-card', product: product %}</li>
              {%- endfor -%}
            </ul>

            {% render 'pagination', paginate: paginate %}
          {%- endif -%}
        </div>

      </div>
    {% endpaginate %}
  </div>
</section>

<style>
  .collection { padding-top: clamp(40px, 5vw, 72px); }

  /* Header */
  .collection__header {
    display: grid;
    gap: 32px;
    align-items: end;
    margin-bottom: clamp(32px, 4vw, 56px);
    padding-bottom: clamp(28px, 3.5vw, 48px);
    border-bottom: 1px solid var(--rule);
  }
  .collection__title { margin: 0; }
  .collection__description { margin-top: 20px; }
  .collection__description > :last-child { margin-bottom: 0; }
  @media (min-width: 990px) {
    .collection__header--media { grid-template-columns: minmax(0, 1fr) minmax(0, .8fr); gap: clamp(48px, 6vw, 96px); }
  }

  /* Layout */
  .collection__layout { display: block; }
  @media (min-width: 990px) {
    .collection__layout--filtered { display: grid; grid-template-columns: 248px minmax(0, 1fr); gap: clamp(40px, 4vw, 64px); align-items: start; }
  }

  /* Toolbar */
  .collection__toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
    min-height: 44px;
    margin-bottom: 28px;
  }
  .collection__count {
    margin: 0 auto 0 0;
    color: var(--fg-muted);
    font: 500 var(--fs-eyebrow)/1.3 var(--sans);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }
  .collection__sort { display: flex; align-items: center; gap: 12px; }
  .collection__sort-label { color: var(--fg-muted); font-size: var(--fs-small); white-space: nowrap; }
  .collection__filter-toggle {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid var(--field-border);
    border-radius: var(--radius);
    background: transparent;
    color: var(--fg);
    font: 500 .72rem/1 var(--sans);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    cursor: pointer;
  }
  .collection__filter-toggle:hover { border-color: var(--fg); }
  .collection__filter-toggle .icon { font-size: 18px; }
  .filters__badge {
    display: inline-grid;
    place-items: center;
    min-width: 18px;
    height: 18px;
    margin-left: 8px;
    padding: 0 5px;
    border-radius: 9px;
    background: var(--accent);
    color: var(--paper);
    font: 500 .65rem/1 var(--sans);
    letter-spacing: 0;
    vertical-align: middle;
  }
  .scheme-forest .filters__badge, .scheme-burgundy .filters__badge { color: var(--ink); }
  @media (max-width: 989px) {
    .collection__count { order: 3; flex-basis: 100%; }
    .collection__sort-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; }
    .collection__toolbar { gap: 16px 12px; }
    .collection__sort { margin-left: auto; }
  }
  @media (min-width: 990px) {
    .collection__filter-toggle { display: none; }
  }

  .collection__chips { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; margin: -8px 0 28px; padding: 0; list-style: none; }
  .collection__clear { margin-left: 8px; font-size: .7rem; }

  /* Filters: drawer on phones and tablets, sidebar on desktop */
  .filters { margin: 0; }
  .filters__head { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 44px; margin-bottom: 28px; }
  .filters__title {
    margin: 0;
    color: var(--fg);
    font: 500 var(--fs-eyebrow)/1.3 var(--sans);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }
  .filters__close { display: none; }
  .filters__list { margin: 0; padding: 0; list-style: none; }
  .filters__list .check.is-disabled { opacity: .5; cursor: default; }
  .filters__price { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .filters__price .field label { margin-bottom: 6px; color: var(--fg-muted); }
  .filters__money { position: relative; }
  .filters__money span { position: absolute; top: 50%; left: 12px; color: var(--fg-muted); font-size: .9rem; transform: translateY(-50%); pointer-events: none; }
  .filters__money input.input { min-height: 44px; padding: 0 8px 0 26px; font-size: .92rem; -moz-appearance: textfield; appearance: textfield; }
  .filters__money input::-webkit-inner-spin-button, .filters__money input::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
  .filters__foot { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .filters__foot .btn { padding-inline: 12px; }

  @media (max-width: 989px) {
    .collection__overlay {
      position: fixed;
      inset: 0;
      z-index: 120;
      background: var(--scrim);
      opacity: 0;
      visibility: hidden;
      transition: opacity var(--dur) var(--ease), visibility var(--dur) var(--ease);
    }
    .collection__overlay.is-open { opacity: 1; visibility: visible; }
    .collection__filters {
      position: fixed;
      top: 0;
      bottom: 0;
      left: 0;
      z-index: 121;
      display: flex;
      flex-direction: column;
      width: min(400px, 90vw);
      background: var(--bg);
      color: var(--fg);
      box-shadow: var(--shadow-soft);
      transform: translateX(-100%);
      visibility: hidden;
      transition: transform .35s var(--ease), visibility .35s var(--ease);
    }
    .collection__filters.is-open { transform: none; visibility: visible; transition: transform .35s var(--ease), visibility 0s; }
    .collection__filters .filters { display: flex; flex-direction: column; height: 100%; }
    .filters__head { margin: 0; padding: 16px var(--gutter); border-bottom: 1px solid var(--rule); }
    .filters__close {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      margin-right: -12px;
      padding: 0;
      border: 0;
      background: none;
      color: inherit;
      font-size: 22px;
      cursor: pointer;
    }
    .filters__body { flex: 1; overflow-y: auto; padding: 0 var(--gutter); border-top: 0; }
    .filters__foot { padding: 16px var(--gutter); border-top: 1px solid var(--rule); }
    html.has-filter-drawer { overflow: hidden; }
  }
  @media (min-width: 990px) {
    .collection__overlay { display: none; }
    .collection__filters { position: sticky; top: 120px; }
    .filters__foot { display: none; }
  }

  /* Grid */
  .collection__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px 16px; margin: 0; padding: 0; list-style: none; }
  .collection__item { min-width: 0; }
  @media (min-width: 768px) {
    .collection__grid { grid-template-columns: repeat(var(--columns, 3), minmax(0, 1fr)); gap: 56px 24px; }
  }
</style>

{% schema %}
{
  "name": "Collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "info": "Small label above the collection title",
      "default": "Shop"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show collection description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "Enable filtering",
      "default": true
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Desktop columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "per_page",
      "label": "Products per page",
      "min": 4,
      "max": 48,
      "step": 4,
      "default": 12
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "cream", "label": "Cream" },
        { "value": "forest", "label": "Dark (primary)" },
        { "value": "burgundy", "label": "Accent" }
      ],
      "default": "light"
    }
  ]
}
{% endschema %}
