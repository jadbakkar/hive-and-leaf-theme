<section class="section scheme-{{ section.settings.color_scheme | default: 'light' }}">
<div class="container">
  <h1>{{ collection.title }}</h1>
  <div>{{ collection.description }}</div>

  {% paginate collection.products by 12 %}
    <div class="grid">
      {% for product in collection.products %}
        {% render 'product-card', product: product %}
      {% endfor %}
    </div>
    {{ paginate | default_pagination }}
  {% endpaginate %}
</div>
</section>

{% schema %}
{
  "name": "Collection",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "cream",
          "label": "Cream"
        },
        {
          "value": "forest",
          "label": "Dark green"
        },
        {
          "value": "burgundy",
          "label": "Burgundy"
        }
      ],
      "default": "light"
    }
  ]
}
{% endschema %}
