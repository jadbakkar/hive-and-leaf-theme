<div class="container section">
  <h1>{{ blog.title }}</h1>

  {% for article in blog.articles %}
    <article style="padding:24px 0;border-bottom:1px solid var(--line);">
      <h2><a href="{{ article.url }}" style="text-decoration:none;">{{ article.title }}</a></h2>
      <p style="color:var(--muted);">{{ article.published_at | date: "%B %d, %Y" }}</p>
      <p>{{ article.excerpt_or_content | strip_html | truncate: 160 }}</p>
    </article>
  {% else %}
    <p>No articles yet.</p>
  {% endfor %}
</div>

{% schema %}
{
  "name": "Blog",
  "settings": []
}
{% endschema %}
