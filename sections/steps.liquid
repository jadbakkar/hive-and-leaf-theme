<section class="section steps {% render 'section-classes', settings: section.settings %}">
  <div class="container">
    <div class="section-header">
      <div class="section-header__titles">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow eyebrow--rule">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="section-header__title">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="lede">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>
    </div>

    <ol class="steps__list" role="list">
      {%- for block in section.blocks -%}
        <li class="steps__step" {{ block.shopify_attributes }}>
          <span class="steps__num" aria-hidden="true">{{ block.settings.number | default: forloop.index }}</span>
          <div class="steps__body">
            <h3 class="steps__title h4"><span class="visually-hidden">Step {{ forloop.index }}: </span>{{ block.settings.title }}</h3>
            <p class="steps__text">{{ block.settings.text }}</p>
          </div>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

<style>
  .steps__list { display: grid; gap: 0; margin: 0; padding: 0; list-style: none; counter-reset: none; }
  .steps__step {
    position: relative;
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: 20px;
    padding: 28px 0;
    border-top: 1px solid var(--rule);
  }
  .steps__step:last-child { border-bottom: 1px solid var(--rule); }
  .steps__num {
    color: var(--accent);
    font: italic var(--heading-weight, 400) 2.4rem/1 var(--serif);
    font-variant-numeric: oldstyle-nums;
  }
  .steps__title { margin: 4px 0 8px; font-size: 1.35rem; }
  .steps__text { margin: 0; color: var(--fg-muted); }

  @media (min-width: 990px) {
    .steps__list { grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); gap: clamp(24px, 3vw, 48px); }
    .steps__step { grid-template-columns: none; gap: 0; padding: 0; border-top: 0; }
    .steps__step:last-child { border-bottom: 0; }
    .steps__num {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: 32px;
      font-size: 3.25rem;
    }
    /* A hairline runs from each numeral to the next step. */
    .steps__num::after { content: ""; flex: 1; height: 1px; background: var(--eyebrow-rule); opacity: .6; }
    .steps__step:last-child .steps__num::after { opacity: .2; }
    .steps__title { margin: 0 0 12px; }
  }
</style>

{% schema %}
{
  "name": "Steps",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "info": "Small label above the heading", "default": "Short label" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Section heading" },
    { "type": "textarea", "id": "text", "label": "Intro text (optional)" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "cream", "label": "Cream" },
        { "value": "forest", "label": "Dark green" },
        { "value": "burgundy", "label": "Burgundy" }
      ],
      "default": "light"
    },
    {
      "type": "select",
      "id": "padding",
      "label": "Spacing",
      "options": [
        { "value": "s", "label": "Small" },
        { "value": "m", "label": "Medium" },
        { "value": "l", "label": "Large" }
      ],
      "default": "m"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "01" },
        { "type": "text", "id": "title", "label": "Title", "default": "Title" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Short description goes here." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Steps",
      "blocks": [
        { "type": "step", "settings": { "number": "01", "title": "Title", "text": "Short description goes here." } },
        { "type": "step", "settings": { "number": "02", "title": "Title", "text": "Short description goes here." } },
        { "type": "step", "settings": { "number": "03", "title": "Title", "text": "Short description goes here." } }
      ]
    }
  ]
}
{% endschema %}
