<section class="section logo-strip {% render 'section-classes', settings: section.settings %}">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <h2 class="logo-strip__title eyebrow eyebrow--flank">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <ul class="logo-strip__grid" role="list">
      {% for block in section.blocks %}
        <li class="logo-strip__logo" {{ block.shopify_attributes }}>
          {% capture logo %}
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 400 | image_tag: class: 'logo-strip__img', loading: 'lazy', alt: block.settings.image.alt }}
            {% else %}
              <div class="img-blank img-blank--small logo-strip__blank" data-label="Logo"></div>
            {% endif %}
          {% endcapture %}

          {% if block.settings.link != blank %}
            <a href="{{ block.settings.link }}">{{ logo }}</a>
          {% else %}
            {{ logo }}
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

<style>
  .logo-strip__title { display: flex; justify-content: center; margin: 0 0 40px; font-size: var(--fs-eyebrow); }
  .logo-strip__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule);
    border-left: 1px solid var(--rule);
  }
  @media (min-width: 768px) { .logo-strip__grid { grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); } }
  .logo-strip__logo {
    display: grid;
    place-items: center;
    min-height: 120px;
    padding: 24px;
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .logo-strip__logo a { display: block; }
  .logo-strip__img { width: auto; max-width: 140px; max-height: 56px; object-fit: contain; filter: grayscale(1); opacity: .7; transition: opacity var(--dur) var(--ease), filter var(--dur) var(--ease); }
  .logo-strip__logo a:hover .logo-strip__img { filter: none; opacity: 1; }
  .logo-strip__blank { width: 120px; aspect-ratio: 5 / 2; outline-offset: -6px; }
  .logo-strip__blank::before { display: none; }
</style>

{% schema %}
{
  "name": "Logo strip",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Section heading" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "cream", "label": "Cream" },
        { "value": "forest", "label": "Dark green" },
        { "value": "burgundy", "label": "Burgundy" }
      ],
      "default": "light"
    },
    {
      "type": "select",
      "id": "padding",
      "label": "Spacing",
      "options": [
        { "value": "s", "label": "Small" },
        { "value": "m", "label": "Medium" },
        { "value": "l", "label": "Large" }
      ],
      "default": "m"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Logo image" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logo strip",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
