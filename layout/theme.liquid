<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }}</title>
  {{ content_for_header }}
  <style>
    html, body { margin: 0; height: 100%; }
    body {
      display: grid; place-items: center; text-align: center;
      background: #fbf8f2; color: #1d1d1b;
      font-family: Georgia, 'Times New Roman', serif;
    }
    h1 { font-weight: 400; font-size: clamp(2rem, 6vw, 3.5rem); margin: 0 0 .4em; }
    p { font-family: system-ui, sans-serif; font-size: .8rem; letter-spacing: .2em; text-transform: uppercase; color: #6b6a63; margin: 0; }
  </style>
</head>
<body>
  {{ content_for_layout }}
</body>
</html>
