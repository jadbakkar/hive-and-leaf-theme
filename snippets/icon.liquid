{%- comment -%}
  Inline SVG icons. Usage: {% render 'icon', name: 'cart' %}
  Names: cart, menu, close, instagram, facebook, tiktok, whatsapp, search, account, plus, minus.
  Icons are decorative (aria-hidden); give the parent link or button an accessible label.
{%- endcomment -%}
<svg class="icon icon--{{ name }}" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
  {%- case name -%}
    {%- when 'cart' -%}
      <path d="M3 4h2.2l2.3 11.1a1 1 0 0 0 1 .8h8.7a1 1 0 0 0 1-.8L20.5 8H6.1"/>
      <circle cx="9.5" cy="19.5" r="1.4"/>
      <circle cx="17" cy="19.5" r="1.4"/>
    {%- when 'menu' -%}
      <path d="M4 7h16M4 12h16M4 17h16"/>
    {%- when 'close' -%}
      <path d="M6 6l12 12M18 6L6 18"/>
    {%- when 'instagram' -%}
      <rect x="3" y="3" width="18" height="18" rx="5"/>
      <circle cx="12" cy="12" r="4"/>
      <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
    {%- when 'facebook' -%}
      <rect x="3" y="3" width="18" height="18" rx="4"/>
      <path d="M13.5 21v-7h2.3l.4-2.7h-2.7V9.6c0-.8.3-1.3 1.4-1.3h1.3V5.9c-.3 0-1.1-.1-2.1-.1-2.1 0-3.5 1.3-3.5 3.6v2h-2.3V14h2.3v7"/>
    {%- when 'tiktok' -%}
      <path d="M14 3v11.2a3.6 3.6 0 1 1-3.6-3.6"/>
      <path d="M14 3c.4 2.7 2.1 4.3 4.7 4.6"/>
    {%- when 'whatsapp' -%}
      <path d="M3.5 20.5l1.3-4A8.5 8.5 0 1 1 8 19.2l-4.5 1.3z"/>
      <path d="M9 9.5c0 3 2.5 5.5 5.5 5.5l.9-1.3-2-1-.9.9c-1-.5-1.9-1.4-2.4-2.4l.9-.9-1-2z"/>
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="6.5"/>
      <path d="M20 20l-4.2-4.2"/>
    {%- when 'account' -%}
      <circle cx="12" cy="8" r="4"/>
      <path d="M4.5 20.5c1.4-3.8 4.2-5.8 7.5-5.8s6.1 2 7.5 5.8"/>
    {%- when 'plus' -%}
      <path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}
      <path d="M5 12h14"/>
  {%- endcase -%}
</svg>
