{%- comment -%}
  Numbered pagination with prev/next arrows. Usage, inside {% paginate %}:
  {% render 'pagination', paginate: paginate %}
{%- endcomment -%}
{%- if paginate.pages > 1 -%}
  <nav class="pagination" aria-label="Pagination">
    {%- if paginate.previous -%}
      <a class="link-arrow link-arrow--back" href="{{ paginate.previous.url }}" rel="prev">Previous</a>
    {%- else -%}
      <span class="link-arrow link-arrow--back" aria-disabled="true">Previous</span>
    {%- endif -%}
    <ul class="pagination__pages" role="list">
      {%- for part in paginate.parts -%}
        <li>
          {%- if part.is_link -%}
            <a class="pagination__link" href="{{ part.url }}"><span class="visually-hidden">Page </span>{{ part.title }}</a>
          {%- elsif part.title contains 'hellip' or part.title == '…' -%}
            <span class="pagination__link" aria-hidden="true">&hellip;</span>
          {%- else -%}
            <span class="pagination__link" aria-current="page"><span class="visually-hidden">Page </span>{{ part.title }}</span>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
    {%- if paginate.next -%}
      <a class="link-arrow" href="{{ paginate.next.url }}" rel="next">Next</a>
    {%- else -%}
      <span class="link-arrow" aria-disabled="true">Next</span>
    {%- endif -%}
  </nav>
{%- endif -%}
