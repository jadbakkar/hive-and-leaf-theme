{%- comment -%}
  Product card. Usage: {% render 'product-card', product: product %}
  The title link stretches over the whole card (see .product-card__title a::after in base.css);
  the quick-add form sits above it so both stay clickable.
{%- endcomment -%}
{%- assign card_alt = product.featured_media.alt | default: product.title -%}
<div class="product-card">
  <a href="{{ product.url }}" class="product-card__media" tabindex="-1" aria-hidden="true">
    <div class="card-media">
      {%- if product.featured_media.media_type == 'image' -%}
        {{ product.featured_media | image_url: width: 800 | image_tag: alt: card_alt, loading: 'lazy', sizes: '(min-width: 768px) 25vw, 70vw', widths: '360, 540, 720, 800' }}
        {%- if product.media.size > 1 and product.media[1].media_type == 'image' -%}
          {{ product.media[1] | image_url: width: 800 | image_tag: alt: '', loading: 'lazy', class: 'product-card__image--alt', sizes: '(min-width: 768px) 25vw, 70vw', widths: '360, 540, 720, 800' }}
        {%- endif -%}
      {%- else -%}
        <div class="img-blank img-blank--portrait" data-label="Product image"></div>
      {%- endif -%}
      {%- if product.available == false -%}
        <span class="product-card__flag badge badge--muted">Sold out</span>
      {%- elsif product.compare_at_price > product.price -%}
        <span class="product-card__flag badge">Sale</span>
      {%- endif -%}
    </div>
  </a>

  <div class="product-card__body">
    <h3 class="product-card__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
    {% render 'price', product: product %}

    <div class="product-card__actions">
    {%- if product.has_only_default_variant and product.available -%}
      {% form 'product', product, class: 'product-card__quick-add' %}
        <input type="hidden" name="id" value="{{ product.first_available_variant.id }}">
        <button type="submit" class="btn btn--link product-card__button">Add to cart<span class="visually-hidden">: {{ product.title }}</span></button>
      {% endform %}
    {%- elsif product.available -%}
      <a href="{{ product.url }}" class="btn btn--link product-card__button">Choose options<span class="visually-hidden">: {{ product.title }}</span></a>
    {%- endif -%}
    </div>
  </div>
</div>
